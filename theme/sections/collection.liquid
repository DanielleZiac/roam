{% comment %}
  Collection page: a colour-block header, category filters, a sort control and the
  product grid. Filtering and sorting are plain links and a normal form, so the
  page works without JavaScript.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

{% liquid
  assign goal_tags = 'get-around,sports,travel,everyday' | split: ','
  assign category_tags = 'chairs-canes,add-ons,sport-gear,hand-gear,computer,speech,alerts,vision,home-living' | split: ','

  # The full catalog always offers every filter. Shopify's tag list for the
  # built-in "all" collection can lag behind product changes, so it is not relied on.
  assign is_catalog = false
  if collection.handle == 'all'
    assign is_catalog = true
  endif

  # When one known tag is active, the page is titled after it, so a filtered
  # view like /collections/all/speech reads as its own category page. Goal tags
  # are not offered as filters here, but the home page's goal tiles link to them.
  assign heading = collection.title
  if is_catalog
    assign heading = 'footer.all_gear' | t
  endif
  assign eyebrow = 'collections.label' | t
  assign active_tag = ''
  if current_tags.size == 1
    assign active_tag = current_tags | first
    if category_tags contains active_tag
      assign heading_key = 'categories.' | append: active_tag | replace: '-', '_'
      assign heading = heading_key | t
      assign eyebrow = 'collections.category_label' | t
    elsif goal_tags contains active_tag
      assign heading_key = 'goals.' | append: active_tag | replace: '-', '_'
      assign heading = heading_key | t
      assign eyebrow = 'collections.goal_label' | t
    endif
  endif
%}

<div class="collection-header full-width scheme-{{ section.settings.color_scheme }}">
  <div class="collection-header__inner">
    <div class="collection-header__text">
      <p class="label">{{ eyebrow }}</p>
      <h1>{{ heading }}</h1>
      {% if collection.description != blank and current_tags == blank %}
        <div class="collection-header__description">{{ collection.description }}</div>
      {% endif %}
    </div>

    {% comment %}
      Shop by goal: one card per goal, shown one at a time. The cards change on
      their own every few seconds; they stop while the pointer or keyboard focus
      is on them, and for good once the pause button or a dot is used. With
      reduced motion on they do not move by themselves; the dots still change the
      card. Without JavaScript the first card is shown.
    {% endcomment %}
    <section class="goal-slider" aria-roledescription="carousel" aria-label="{{ 'goals.slider_label' | t }}" data-goal-slider>
      <div class="goal-slider__layout">
      <div class="goal-slider__head">
        <p class="label">{{ 'goals.slider_label' | t }}</p>
        <button
          class="goal-slider__pause"
          type="button"
          aria-label="{{ 'goals.slider_pause' | t }}"
          data-goal-pause
          data-label-pause="{{ 'goals.slider_pause' | t }}"
          data-label-play="{{ 'goals.slider_play' | t }}"
          hidden
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" data-icon-pause>
            <rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" />
          </svg>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" data-icon-play hidden>
            <path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z" />
          </svg>
        </button>
      </div>

      <div class="goal-slider__stage">
      <div class="goal-slider__viewport">
        <ul class="goal-slider__track" role="list" data-goal-track>
          {% for tag in goal_tags %}
            {% liquid
              assign goal_key = 'goals.' | append: tag | replace: '-', '_'
              assign goal_text_key = goal_key | append: '_text'
              assign goal_title = goal_key | t
            %}
            <li
              class="goal-slide has-goal-photo"
              role="group"
              aria-roledescription="slide"
              aria-label="{{ 'goals.slider_position' | t: position: forloop.index, total: goal_tags.size }}"
              data-goal-slide
              data-title="{{ goal_title | escape }}"
            >
              {% render 'goal-photo', goal: tag, sizes: '(min-width: 60rem) 20rem, 40vw' %}
              {% # The number sits on the same line as the name, which keeps the card short. %}
              <h2 class="goal-slide__title">
                <span class="goal-slide__number" aria-hidden="true">0{{ forloop.index }}</span>
                <a href="{{ routes.all_products_collection_url }}/{{ tag }}">{{ goal_title }}</a>
              </h2>
              <p class="goal-slide__text">{{ goal_text_key | t }}</p>
              <span class="goal-slide__arrow" aria-hidden="true">&rarr;</span>
            </li>
          {% endfor %}
        </ul>
      </div>
        <div class="goal-slider__dots" data-goal-dots data-label="{{ 'goals.slider_show' | t: title: '[title]' }}"></div>
      </div>
      </div>
    </section>
  </div>
</div>

{% capture category_chips %}
  {% for tag in category_tags %}
    {% if is_catalog or collection.all_tags contains tag %}
      {% assign tag_key = 'categories.' | append: tag | replace: '-', '_' %}
      <li>
        <a class="chip" href="{{ collection.url }}/{{ tag }}" {% if active_tag == tag %}aria-current="true"{% endif %}>
          {{ tag_key | t }}
        </a>
      </li>
    {% endif %}
  {% endfor %}
{% endcapture %}

<div class="collection-layout">
  <aside class="collection-sidebar" aria-label="{{ 'collections.filters_heading' | t }}">
    <h2 class="collection-sidebar__title">{{ 'collections.filters_heading' | t }}</h2>
    {% # Phones only: shows and hides the filter groups. Hidden until the script confirms it can work. %}
    <button class="collection-sidebar__toggle" type="button" aria-expanded="false" hidden data-filters-toggle>
      {{ 'icon-sliders-horizontal.svg' | inline_asset_content }}
      <span>
        {{ 'collections.filters_heading' | t }}
        {%- if active_tag != blank -%}
          <span class="collection-sidebar__active">: {{ heading }}</span>
        {%- endif -%}
      </span>
      <span class="collection-sidebar__chevron" aria-hidden="true">
        {{- 'icon-chevron-down.svg' | inline_asset_content -}}
      </span>
    </button>
    {% assign category_chips_text = category_chips | strip %}
    {% if category_chips_text != blank %}
      <nav class="collection-filters" aria-label="{{ 'collections.category_filter_label' | t }}">
        <span class="label" aria-hidden="true">{{ 'collections.category_filter_label' | t }}</span>
        <ul role="list">
          <li>
            <a class="chip" href="{{ collection.url }}" {% if current_tags == blank %}aria-current="true"{% endif %}>
              {{ 'collections.filter_all' | t }}
            </a>
          </li>
          {{ category_chips }}
        </ul>
      </nav>
    {% endif %}

  </aside>

  <div class="collection-main">
  {% comment %}
    Search and sort share one row. Both update the product grid in place (see the
    script below). Without JavaScript, search opens the search page and sort
    shows a button.
  {% endcomment %}
  <div class="collection-bar">
    <form
      id="catalog-search"
      class="catalog-search"
      action="{{ routes.search_url }}"
      method="get"
      role="search"
      data-catalog-search
    >
      <label class="visually-hidden" for="CollectionSearch-{{ section.id }}">{{ 'search.label' | t }}</label>
      <input
        id="CollectionSearch-{{ section.id }}"
        type="search"
        name="q"
        placeholder="{{ 'search.placeholder' | t }}"
      >
      <input type="hidden" name="type" value="product">
      <button type="submit" aria-label="{{ 'search.submit' | t }}">
        {{ 'icon-search.svg' | inline_asset_content }}
      </button>
    </form>

    <form class="collection-sort" method="get" data-catalog-sort>
      <label for="SortBy-{{ section.id }}">{{ 'collections.sort_label' | t }}</label>
      <select id="SortBy-{{ section.id }}" name="sort_by">
        <option value="">{{ 'collections.sort_recommended' | t }}</option>
        <option value="price-ascending" {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>
          {{ 'collections.sort_price_low' | t }}
        </option>
        <option value="price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>
          {{ 'collections.sort_price_high' | t }}
        </option>
      </select>
      <noscript>
        <button class="button button--secondary button--small" type="submit">{{ 'collections.sort_apply' | t }}</button>
      </noscript>
    </form>
  </div>

  <div data-catalog-results>
{% paginate collection.products by section.settings.per_page %}
  <p class="collection-count" role="status">
    {{ 'collections.count' | t: count: collection.products_count }}
  </p>

  {% if collection.products.size > 0 %}
    <ul class="product-grid" role="list">
      {% for product in collection.products %}
        <li>{% render 'product-card', product: product, heading_tag: 'h2' %}</li>
      {% endfor %}
    </ul>
  {% else %}
    <div class="collection-empty scheme-panel">
      <h2>{{ 'collections.empty_title' | t }}</h2>
      <p>{{ 'collections.empty_text' | t }}</p>
      <a class="button" href="{{ collection.url }}">{{ 'collections.empty_button' | t }}</a>
    </div>
  {% endif %}

  {% if paginate.pages > 1 %}
    <nav class="pagination" aria-label="{{ 'collections.pagination_label' | t }}">
      {{ paginate | default_pagination }}
    </nav>
  {% endif %}
{% endpaginate %}
  </div>
  </div>
</div>

{% stylesheet %}
  .collection-header__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding: clamp(1.25rem, 3vw, 2.25rem) var(--page-margin);
  }
  /*
   * The title on the left and the Shop by goal cards on the right, always in one row.
   * The cards' column narrows with the screen, and the cards adapt to their own width below.
   */
  .collection-header__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(9rem, 38vw, 27rem);
    gap: clamp(0.75rem, 3vw, 2rem);
    align-items: center;
  }
  .goal-slider {
    container-type: inline-size;
  }
  /* Narrow: the label, pause button and dots sit above the card. */
  .goal-slider__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 0.5rem;
    margin-bottom: 0.5rem;
  }
  /* Roomy: they move to the left of the card, so the band is only as tall as the card. */
  @container (min-width: 22rem) {
    .goal-slider__layout {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: 1rem;
      align-items: center;
    }
    /* The pause button stands above the label, both centred. */
    .goal-slider__head {
      flex-direction: column-reverse;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      margin-bottom: 0;
    }
  }
  .goal-slider__head .label {
    margin: 0;
  }
  .goal-slider__pause {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .goal-slider__pause svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: currentColor;
  }
  .goal-slider__viewport {
    overflow: hidden;
    border-radius: 1.25rem;
  }
  .goal-slider__track {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .goal-slide {
    position: relative;
    display: flex;
    flex: 0 0 100%;
    flex-direction: column;
    justify-content: center;
    gap: 0.25rem;
    padding: 0.75rem 1.25rem;
    border-radius: 1.25rem;
  }
  /* A narrow card (phones) keeps the number, the name and the arrow, and drops the description. */
  @container (max-width: 15rem) {
    .goal-slide {
      padding: 0.75rem 0.875rem;
    }
    .goal-slide__title {
      padding-right: 1.5rem;
      font-size: 1.125rem;
    }
    .goal-slide__text {
      display: none;
    }
    .goal-slide__arrow {
      right: 0.875rem;
      bottom: 0.75rem;
      font-size: 1.25rem;
    }
    .goal-slider__pause {
      width: 2.25rem;
      height: 2.25rem;
    }
  }
  .goal-slide__number {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 400;
  }
  .goal-slide__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.5rem;
    font-size: 1.5rem;
  }
  .goal-slide__title a {
    color: inherit;
    text-decoration: none;
  }
  /* Stretch the link over the whole card. */
  .goal-slide__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .goal-slide__title a:focus-visible {
    outline: none;
  }
  .goal-slide:has(a:focus-visible) {
    outline: 3px solid var(--color-foreground);
    outline-offset: -3px;
    box-shadow: inset 0 0 0 6px var(--color-background);
  }
  .goal-slide__text {
    max-width: 28ch;
    margin: 0;
    padding-right: 1.75rem;
  }
  .goal-slide__arrow {
    position: absolute;
    right: 1.25rem;
    bottom: 1rem;
    font-size: 1.5rem;
    line-height: 1;
  }
  /* Dots: one per card. Each is a 24px target with a smaller mark inside. */
  /* Dots sit under the card, centred on it. */
  .goal-slider__dots {
    display: flex;
    justify-content: center;
    gap: 0.25rem;
    margin-top: 0.25rem;
  }
  .goal-slider__dots button {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .goal-slider__dots button::before {
    content: '';
    width: 0.75rem;
    height: 0.75rem;
    border: 1.5px solid currentColor;
    border-radius: 50%;
  }
  .goal-slider__dots button[aria-current='true']::before {
    background-color: currentColor;
  }
  @media (prefers-reduced-motion: no-preference) {
    .goal-slider__track {
      transition: translate 0.45s ease;
    }
  }
  .collection-header h1 {
    max-width: 16ch;
    font-size: clamp(1.75rem, 6.5vw, 4.5rem);
    line-height: 1;
  }
  .collection-header__description {
    max-width: 44ch;
    margin-top: 1.25rem;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
  }
  .collection-layout {
    display: grid;
    gap: 1.5rem;
    padding-block: 2rem clamp(3rem, 7vw, 5rem);
  }
  /*
   * Filters: one bordered card. Each option is a full-width row with a radio-style
   * marker, grouped under a small label with a rule between groups.
   * Wide screens show it as a sticky side panel. Phones and tablets fold it into a
   * single "Filters" bar that opens when pressed.
   */
  .collection-sidebar {
    align-self: start;
    padding: 1.25rem 1rem 0.5rem;
    border: 1.5px solid var(--color-foreground);
    border-radius: 1.25rem;
  }
  .collection-sidebar__title {
    margin: 0 0.5rem 1rem;
    font-size: 1.375rem;
  }
  .collection-sidebar__toggle {
    display: none;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    min-height: 3rem;
    padding: 0 0.5rem;
    border: 0;
    background: none;
    color: var(--color-foreground);
    font: inherit;
    font-weight: 600;
    text-align: left;
    cursor: pointer;
  }
  .collection-sidebar__toggle svg {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
  }
  .collection-sidebar__active {
    font-weight: 400;
  }
  .collection-sidebar__chevron {
    display: grid;
    margin-left: auto;
  }
  .collection-sidebar__toggle[aria-expanded='true'] .collection-sidebar__chevron {
    rotate: 180deg;
  }
  .collection-filters {
    display: grid;
    gap: 0.375rem;
    padding-block: 1rem 0.75rem;
    border-top: 1.5px solid var(--color-foreground);
  }
  .collection-filters .label {
    margin-inline: 0.5rem;
  }
  .collection-filters ul {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .collection-sidebar .chip {
    display: flex;
    justify-content: flex-start;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0.5rem;
    border: 0;
    border-radius: 0.625rem;
    font-weight: 400;
  }
  /* Radio-style marker: an empty ring, filled when the option is active. */
  .collection-sidebar .chip::before {
    content: '';
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    border: 1.5px solid var(--color-foreground);
    border-radius: 50%;
  }
  /* The filters use a pale tint of the lime: one part lime to three parts white. Dark text on it is about 16:1. */
  .collection-sidebar {
    --filter-tint: color-mix(in srgb, var(--color-panel) 25%, var(--color-background));
  }
  .collection-sidebar .chip:hover {
    background-color: var(--filter-tint);
  }
  .collection-sidebar .chip[aria-current='true'] {
    background-color: var(--filter-tint);
    color: var(--color-foreground);
    font-weight: 600;
  }
  .collection-sidebar .chip[aria-current='true']::before {
    background-color: var(--color-foreground);
    box-shadow: inset 0 0 0 3px var(--filter-tint);
  }
  /* Phones and tablets: the card is a single Filters bar until it is opened. */
  @media (max-width: 59.99rem) {
    .collection-layout {
      padding-top: 1.25rem;
    }
    .collection-sidebar.has-toggle {
      padding: 0.25rem 0.5rem;
    }
    .collection-sidebar.has-toggle .collection-sidebar__title {
      display: none;
    }
    .collection-sidebar.has-toggle .collection-sidebar__toggle {
      display: flex;
    }
    .collection-sidebar.has-toggle:not(.is-open) .collection-filters {
      display: none;
    }
    /* Two options per row, so the open list stays short. */
    .collection-filters ul {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .collection-main {
    min-width: 0;
  }
  .collection-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-bottom: 1.25rem;
  }
  .catalog-search {
    position: relative;
    flex: 1 1 14rem;
  }
  .catalog-search input[type='search'] {
    width: 100%;
    padding: 0.5rem 3.25rem 0.5rem 1.25rem;
    border-radius: 999px;
  }
  /* The magnifier sits inside the right end of the box and submits the search. */
  .catalog-search button {
    position: absolute;
    top: 0;
    right: 0;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--color-foreground);
    cursor: pointer;
  }
  .catalog-search svg {
    width: 1.5rem;
    height: 1.5rem;
  }
  .collection-sort select {
    border-radius: 999px;
    padding-inline: 1rem 2.75rem;
  }
  /* Wide screens: the filter card becomes a sticky side panel beside the products. */
  @media (min-width: 60rem) {
    .collection-layout {
      grid-template-columns: 16rem minmax(0, 1fr);
      gap: 2.5rem;
    }
    .collection-sidebar {
      position: sticky;
      top: 1.5rem;
    }
    .collection-main .product-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .collection-sort {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .collection-sort label {
    font-weight: 500;
  }
{% endstylesheet %}

{% javascript %}
  // Shop by goal cards in the header: change every few seconds, with a pause button and dots.
  (() => {
    const slider = document.querySelector('[data-goal-slider]');
    if (!slider) return;
    const track = slider.querySelector('[data-goal-track]');
    const slides = [...slider.querySelectorAll('[data-goal-slide]')];
    const dots = slider.querySelector('[data-goal-dots]');
    const pause = slider.querySelector('[data-goal-pause]');
    if (slides.length < 2) return;

    let index = 0;
    let timer = null;
    // Stopped for good by the pause button or a dot; visitors who asked for reduced motion start stopped.
    let stopped = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const dotButtons = slides.map((slide, position) => {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.setAttribute('aria-label', dots.dataset.label.replace('[title]', slide.dataset.title));
      dot.addEventListener('click', () => {
        stop();
        show(position);
      });
      dots.append(dot);
      return dot;
    });

    function show(next) {
      index = next;
      track.style.translate = `${-100 * index}% 0`;
      slides.forEach((slide, position) => {
        // Cards that are out of view are skipped by the keyboard and by screen readers.
        slide.inert = position !== index;
      });
      dotButtons.forEach((dot, position) => {
        if (position === index) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    }

    function run() {
      clearInterval(timer);
      timer = null;
      if (!stopped) timer = setInterval(() => show((index + 1) % slides.length), 4000);
    }

    function hold() {
      clearInterval(timer);
      timer = null;
    }

    function stop() {
      stopped = true;
      hold();
      syncPause();
    }

    function syncPause() {
      pause.setAttribute('aria-label', stopped ? pause.dataset.labelPlay : pause.dataset.labelPause);
      pause.querySelector('[data-icon-pause]').toggleAttribute('hidden', stopped);
      pause.querySelector('[data-icon-play]').toggleAttribute('hidden', !stopped);
      // While the cards move on their own, changes are not read out; once stopped, they are.
      track.setAttribute('aria-live', stopped ? 'polite' : 'off');
    }

    pause.hidden = false;
    pause.addEventListener('click', () => {
      stopped = !stopped;
      syncPause();
      run();
    });
    slider.addEventListener('mouseenter', hold);
    slider.addEventListener('mouseleave', run);
    slider.addEventListener('focusin', hold);
    slider.addEventListener('focusout', run);

    show(0);
    syncPause();
    run();
  })();

  // Catalog search and sort: both redraw the product grid in place, so shoppers never leave this page.
  (() => {
    const searchForm = document.querySelector('[data-catalog-search]');
    const sortForm = document.querySelector('[data-catalog-sort]');
    if (!searchForm || !sortForm) return;

    const input = searchForm.querySelector('input[type="search"]');
    const select = sortForm.querySelector('select');
    const results = searchForm.closest('.collection-main').querySelector('[data-catalog-results]');

    // Keeps the address in step, so a search or sort can be reloaded, bookmarked or shared.
    function setUrl(term, sort) {
      const url = new URL(window.location.href);
      url.searchParams.delete('page');
      if (term) url.searchParams.set('q', term);
      else url.searchParams.delete('q');
      if (sort) url.searchParams.set('sort_by', sort);
      else url.searchParams.delete('sort_by');
      window.history.replaceState(null, '', url);
    }

    async function load() {
      const term = input.value.trim();
      const sort = select.value;
      const params = new URLSearchParams();
      if (sort) params.set('sort_by', sort);

      // With a search term, ask Shopify's search. Without one, ask this collection page.
      let path = window.location.pathname;
      let block = '[data-catalog-results]';
      if (term) {
        path = searchForm.getAttribute('action');
        block = '.search-results';
        params.set('q', term);
        params.set('type', 'product');
      }

      results.setAttribute('aria-busy', 'true');
      try {
        const response = await fetch(`${path}?${params}`);
        const page = new DOMParser().parseFromString(await response.text(), 'text/html');
        const found = page.querySelector(block);
        if (!found) throw new Error('No results block');
        if (term) found.querySelectorAll('.pagination').forEach((node) => node.remove());
        results.replaceChildren(...found.childNodes);
        setUrl(term, sort);
        document.dispatchEvent(new Event('roam:cards-updated'));
      } catch {
        // If anything goes wrong, fall back to a normal page load.
        if (term) searchForm.submit();
        else sortForm.submit();
      } finally {
        results.removeAttribute('aria-busy');
      }
    }

    searchForm.addEventListener('submit', (event) => {
      event.preventDefault();
      load();
    });
    // The small x that browsers show inside a search box clears the search.
    input.addEventListener('search', () => {
      if (input.value === '') load();
    });
    select.addEventListener('change', load);

    // Phones: the Filters button opens and closes the filter groups.
    const sidebar = document.querySelector('.collection-sidebar');
    const filtersToggle = sidebar && sidebar.querySelector('[data-filters-toggle]');
    if (filtersToggle) {
      sidebar.classList.add('has-toggle');
      filtersToggle.hidden = false;
      filtersToggle.addEventListener('click', () => {
        const open = sidebar.classList.toggle('is-open');
        filtersToggle.setAttribute('aria-expanded', String(open));
      });
    }

    // A search in the address (?q=...) is restored, and the header's search icon lands in the box.
    const startTerm = new URL(window.location.href).searchParams.get('q');
    if (startTerm) {
      input.value = startTerm;
      load();
    }
    if (window.location.hash === '#catalog-search') input.focus();
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Header colour block",
      "options": [
        { "value": "panel", "label": "Lime" },
        { "value": "highlight", "label": "Bright teal" },
        { "value": "action", "label": "Lime accent" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "panel"
    },
    {
      "type": "range",
      "id": "per_page",
      "min": 8,
      "max": 24,
      "step": 4,
      "label": "Products per page",
      "default": 12
    }
  ]
}
{% endschema %}
