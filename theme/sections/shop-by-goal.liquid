{% comment %}
  "Shop by goal": lets shoppers browse by what they want to do, not by a diagnosis.
  Each goal is a block the merchant can add, remove, reorder and point at any link.
{% endcomment %}

<div class="goals">
  <div class="goals__intro">
    <h2>{{ section.settings.heading }}</h2>
    {% if section.settings.text != blank %}
      <p>{{ section.settings.text }}</p>
    {% endif %}
  </div>

  <ul class="goals__list" role="list">
    {% for block in section.blocks %}
      {% liquid
        # A card whose link ends in a goal tag (e.g. /collections/all/sports) gets that goal's photo.
        assign goal_tag = block.settings.link | split: '/' | last
        assign goal_tags = 'get-around,sports,travel,everyday' | split: ','
        assign has_photo = false
        if goal_tags contains goal_tag
          assign has_photo = true
        endif
      %}
      {% # A card with a photo drops its colour block; the cycle still advances so the rest keep their colours. %}
      {% capture goal_scheme %}{% cycle 'panel', 'highlight', 'dark', 'violet' %}{% endcapture %}
      <li class="goal {% if has_photo %}has-goal-photo{% else %}scheme-{{ goal_scheme }}{% endif %}" {{ block.shopify_attributes }}>
        {% if has_photo %}
          {% render 'goal-photo', goal: goal_tag, sizes: '(min-width: 64rem) 25vw, 50vw' %}
        {% endif %}
        <span class="goal__number" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>
        <h3 class="goal__title">
          <a href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.title }}</a>
        </h3>
        {% if block.settings.text != blank %}
          <p class="goal__text">{{ block.settings.text }}</p>
        {% endif %}
        <span class="goal__arrow" aria-hidden="true">&rarr;</span>
      </li>
    {% endfor %}
  </ul>
</div>

{% stylesheet %}
  .goals {
    padding-block: clamp(3rem, 7vw, 5rem);
  }
  .goals__intro {
    max-width: 40rem;
    margin-bottom: 2rem;
  }
  .goals__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .goal {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 17rem;
    padding: 1.5rem;
    border-radius: 1.25rem;
  }
  .goal__number {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
  }
  .goal__title {
    margin-block: auto 0.5rem;
    font-size: clamp(1.75rem, 2.8vw, 2.25rem);
  }
  .goal__title a {
    color: inherit;
    text-decoration: none;
  }
  /* Stretch the link over the whole card. */
  .goal__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .goal__title a:focus-visible {
    outline: none;
  }
  .goal:has(a:focus-visible) {
    outline: 3px solid var(--color-foreground);
    outline-offset: 3px;
  }
  .goal__text {
    margin: 0;
    padding-right: 2.5rem;
  }
  .goal__arrow {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    font-size: 1.75rem;
    line-height: 1;
  }
  /* Hover: a thick inner ring in the card's own text colour. */
  .goal:hover {
    box-shadow: inset 0 0 0 4px var(--scheme-text);
  }
  /* Phones: a two-by-two grid of shorter cards, without the descriptions. */
  @media (max-width: 35.99rem) {
    .goals__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.625rem;
    }
    .goal {
      min-height: 9rem;
      padding: 1rem;
    }
    .goal__title {
      font-size: 1.25rem;
    }
    .goal__text {
      display: none;
    }
    .goal__arrow {
      right: 1rem;
      bottom: 0.875rem;
      font-size: 1.25rem;
    }
    .goal__title a {
      padding-right: 1.5rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .goal {
      transition: box-shadow 0.15s, translate 0.15s;
    }
    .goal:hover {
      translate: 0 -0.25rem;
    }
    .goal__arrow {
      transition: transform 0.15s;
    }
    .goal:hover .goal__arrow {
      transform: translateX(0.25rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop by goal",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by goal"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Supporting line",
      "default": "Start with what you want to do. We'll show the gear that gets you there."
    }
  ],
  "blocks": [
    {
      "type": "goal",
      "name": "Goal",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Goal",
          "default": "Get around"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Short description"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Shop by goal",
      "blocks": [
        { "type": "goal", "settings": { "title": "Get around" } },
        { "type": "goal", "settings": { "title": "Play sports" } },
        { "type": "goal", "settings": { "title": "Travel" } },
        { "type": "goal", "settings": { "title": "Everyday carry" } }
      ]
    }
  ]
}
{% endschema %}
