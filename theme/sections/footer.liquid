{% comment %}
  Site footer: brand line, the need-group collections, help links, the store's
  contact details and social links (from Theme settings > Store contact details),
  then payment icons and the copyright line.
{% endcomment %}

<footer class="footer full-width on-dark">
  <div class="footer__inner">
    <div class="footer__brand">
      <p class="footer__logo">
        <span class="visually-hidden">{{ shop.name }}</span>
        {{ 'logo-roam.svg' | inline_asset_content }}
      </p>
      <p>{{ 'footer.tagline' | t }}</p>

      <ul class="footer__social" role="list">
        {% if settings.social_instagram != blank %}
          <li>
            <a href="{{ settings.social_instagram }}">
              {{ 'icon-instagram.svg' | inline_asset_content }}
              <span class="visually-hidden">Instagram</span>
            </a>
          </li>
        {% endif %}
        {% if settings.social_facebook != blank %}
          <li>
            <a href="{{ settings.social_facebook }}">
              {{ 'icon-facebook.svg' | inline_asset_content }}
              <span class="visually-hidden">Facebook</span>
            </a>
          </li>
        {% endif %}
        {% if settings.social_tiktok != blank %}
          <li>
            <a href="{{ settings.social_tiktok }}">
              {{ 'icon-tiktok.svg' | inline_asset_content }}
              <span class="visually-hidden">TikTok</span>
            </a>
          </li>
        {% endif %}
      </ul>
    </div>

    <nav class="footer__column" aria-labelledby="FooterShop">
      <h2 id="FooterShop" class="footer__heading">{{ 'footer.shop' | t }}</h2>
      <ul role="list">
        <li><a href="{{ routes.all_products_collection_url }}">{{ 'footer.all_gear' | t }}</a></li>
        {% for collection in collections %}
          {% unless collection.handle == 'frontpage' or collection.handle == 'all' %}
            <li><a href="{{ collection.url }}">{{ collection.title }}</a></li>
          {% endunless %}
        {% endfor %}
      </ul>
    </nav>

    <nav class="footer__column" aria-labelledby="FooterHelp">
      <h2 id="FooterHelp" class="footer__heading">{{ 'footer.help' | t }}</h2>
      <ul role="list">
        <li><a href="{{ routes.root_url }}pages/find-my-gear">{{ 'footer.find_my_gear' | t }}</a></li>
        <li><a href="{{ routes.root_url }}pages/contact">{{ 'footer.contact' | t }}</a></li>
        <li><a href="{{ routes.root_url }}pages/contact#shipping">{{ 'contact.shipping_title' | t }}</a></li>
        <li><a href="{{ routes.root_url }}pages/contact#returns">{{ 'contact.returns_title' | t }}</a></li>
        <li><a href="{{ routes.root_url }}pages/contact#accessibility">{{ 'contact.accessibility_title' | t }}</a></li>
        {% for link in section.settings.menu.links %}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {% endfor %}
      </ul>
    </nav>

    <div class="footer__column">
      <h2 class="footer__heading">{{ 'footer.reach_us' | t }}</h2>
      <ul class="footer__reach" role="list">
        <li>
          {{ 'icon-phone.svg' | inline_asset_content }}
          <span class="visually-hidden">{{ 'contact.phone' | t }}:</span>
          <a href="tel:{{ settings.contact_phone | remove: ' ' | remove: '(' | remove: ')' }}">
            {{- settings.contact_phone -}}
          </a>
        </li>
        <li>
          {{ 'icon-mail.svg' | inline_asset_content }}
          <span class="visually-hidden">{{ 'contact.email' | t }}:</span>
          <a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a>
        </li>
        <li>
          {{ 'icon-map-pin.svg' | inline_asset_content }}
          <span class="visually-hidden">{{ 'contact.visit' | t }}:</span>
          <span>{{ settings.contact_address | newline_to_br }}</span>
        </li>
        <li>
          {{ 'icon-clock.svg' | inline_asset_content }}
          <span class="visually-hidden">{{ 'contact.hours' | t }}:</span>
          <span>{{ settings.contact_hours }}</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="footer__bottom">
    {% if section.settings.show_payment_icons %}
      <ul class="footer__payment" role="list">
        {% for type in shop.enabled_payment_types %}
          <li>{{ type | payment_type_svg_tag }}</li>
        {% endfor %}
      </ul>
    {% endif %}

    <p class="footer__copyright">
      &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'footer.rights' | t }}
    </p>
  </div>
</footer>

{% stylesheet %}
  /* Footer text is a step smaller than the page. Dyslexia-friendly text puts it back up (roam.css). */
  .footer {
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .footer__inner,
  .footer__bottom {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }
  .footer__inner {
    display: grid;
    gap: 2rem;
    padding-block: 2.5rem 2rem;
  }
  .footer__logo {
    margin-bottom: 0.75rem;
  }
  .footer__logo svg {
    width: auto;
    height: 1.75rem;
  }
  .footer__brand p {
    max-width: 28ch;
  }
  .footer__heading {
    margin-bottom: 0.5rem;
    font-size: 0.9375rem;
    letter-spacing: 0;
  }
  .footer ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer__column li {
    padding-block: 0.125rem;
  }
  .footer__column a {
    display: inline-block;
    padding-block: 0.25rem;
    text-decoration: none;
  }
  .footer__column a:hover {
    text-decoration: underline;
  }
  .footer__reach li {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    padding-block: 0.375rem;
  }
  .footer__reach svg {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    margin-top: 0.125rem;
    color: var(--color-highlight);
  }
  .footer__reach a {
    padding-block: 0;
  }
  .footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  /* Round icon links, 44px targets. */
  .footer__social a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1.5px solid currentColor;
    border-radius: 50%;
  }
  .footer__social a:hover {
    border-color: var(--color-highlight);
    background-color: var(--color-highlight);
    color: var(--color-foreground);
  }
  .footer__social svg {
    width: 1.25rem;
    height: 1.25rem;
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1rem 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.25);
  }
  .footer__payment {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .footer__copyright {
    margin: 0;
    font-size: 0.8125rem;
  }
  @media (min-width: 36rem) {
    .footer__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 60rem) {
    .footer__inner {
      grid-template-columns: 1.3fr 1fr 1fr 1.3fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Extra help links",
      "info": "Added to the end of the Help column."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    }
  ]
}
{% endschema %}
