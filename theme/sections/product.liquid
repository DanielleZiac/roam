{% comment %}
  Product page: photos, a plain-language summary, price, the add-to-cart form
  and a "Key facts" card with the specs.

  The summary and key facts come from the product's "roam" metafields, which the
  merchant edits in the Roam Insights app. Products that have not been edited
  there fall back to the description: its first paragraph is the summary and
  its bullet list becomes the Key facts card.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign type_handle = product.type | handleize
  assign type_collection = collections[type_handle]
  assign description_parts = product.description | split: '<ul>'
  assign summary = description_parts | first
  if description_parts.size > 1
    assign facts = product.description | remove_first: summary
  endif

  assign app_facts = product.metafields.roam.key_facts.value
  assign app_summary = product.metafields.roam.summary.value | strip
%}

{% liquid
  assign view_price = product.price | money
  assign view_image = nil
  if product.featured_image
    assign view_image = product.featured_image | image_url: width: 600, height: 600, crop: 'center'
  endif
%}
{%- capture view_json -%}
  {
    "handle": {{ product.handle | json }},
    "title": {{ product.title | json }},
    "url": {{ product.url | json }},
    "type": {{ product.type | json }},
    "price": {{ view_price | json }},
    "image": {{ view_image | json }},
    "variant": {{ current_variant.id | json }},
    "quickAdd": {% if product.available and product.has_only_default_variant %}true{% else %}false{% endif %}
  }
{%- endcapture -%}
{% # Read by assets/roam-shop.js to remember this product as recently viewed. %}
<script type="application/json" data-product-view>{{ view_json }}</script>

<nav class="breadcrumb" aria-label="{{ 'accessibility.breadcrumb' | t }}">
  <ol role="list">
    <li><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a></li>
    {% if type_collection.url %}
      <li><a href="{{ type_collection.url }}">{{ type_collection.title }}</a></li>
    {% endif %}
    <li aria-current="page">{{ product.title }}</li>
  </ol>
</nav>

<div class="product">
  <div class="product__media">
    {% if product.featured_image %}
      {% comment %}
        One large photo with a row of small previews under it. Without JavaScript
        every photo simply shows, one under the other.
      {% endcomment %}
      <ul class="product__images" role="list" data-gallery>
        {% for image in product.images %}
          {% liquid
            assign loading = 'lazy'
            if forloop.first
              assign loading = 'eager'
            endif
          %}
          <li data-gallery-photo>
            {{
              image
              | image_url: width: 1400
              | image_tag: loading: loading, sizes: '(min-width: 60rem) 50vw, 100vw', widths: '500, 800, 1100, 1400'
            }}
          </li>
        {% endfor %}
      </ul>

      {% if product.images.size > 1 %}
        <ul class="product__thumbs" role="list" data-gallery-thumbs hidden>
          {% for image in product.images %}
            <li>
              <button
                type="button"
                class="product__thumb"
                aria-label="{{ 'products.show_photo' | t: number: forloop.index, total: product.images.size }}"
                {% if forloop.first %}
                  aria-current="true"
                {% endif %}
              >
                {{
                  image
                  | image_url: width: 240, height: 240, crop: 'center'
                  | image_tag: loading: 'eager', alt: '', width: 120, height: 120
                }}
              </button>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    {% else %}
      <div class="product__placeholder">
        {{ 'product-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="product__info">
    {% if product.type != blank %}
      <p class="label">{{ product.type }}</p>
    {% endif %}

    <h1 class="product__title" data-read>{{ product.title }}</h1>

    {% liquid
      assign page_rating = product.metafields.roam.rating.value
      assign page_rating_count = product.metafields.roam.rating_count.value | default: 0
    %}
    {% if page_rating_count > 0 %}
      {% capture page_rating_label %}Rated {{ page_rating }} out of 5{% endcapture %}
      <p class="product__rating">
        {% render 'stars', rating: page_rating, label: page_rating_label %}
        <a href="#reviews">{{ page_rating }} ({{ page_rating_count }} reviews)</a>
      </p>
    {% endif %}

    <p class="product__price" data-read>
      <span class="visually-hidden">{{ 'products.price' | t }}</span>
      {{ current_variant.price | money }}
      {% if current_variant.compare_at_price > current_variant.price %}
        <s class="product__compare">
          <span class="visually-hidden">{{ 'products.was' | t }}</span>
          {{ current_variant.compare_at_price | money }}
        </s>
      {% endif %}
    </p>

    {% if app_summary != blank %}
      <div class="product__summary rte" data-read><p>{{ app_summary | escape }}</p></div>
    {% elsif summary != blank %}
      <div class="product__summary rte" data-read>{{ summary }}</div>
    {% endif %}

    {% # Shown only when "Read it to me" is switched on in the Accessibility panel. %}
    <div class="listen" data-listen>
      <button class="button button--secondary button--small" type="button" aria-pressed="false" data-listen-button>
        <span data-listen-label data-listen="{{ 'products.listen' | t }}" data-stop="{{ 'products.listen_stop' | t }}">
          {{- 'products.listen' | t -}}
        </span>
      </button>
      <span class="visually-hidden" role="status" data-listen-status data-reading="{{ 'products.listen_reading' | t }}"></span>
    </div>

    {% form 'product', product, class: 'product__form', data-handle: product.handle %}
      {% if product.has_only_default_variant %}
        <input type="hidden" name="id" value="{{ current_variant.id }}">
      {% else %}
        <div class="field">
          <label for="Variant-{{ section.id }}">{{ 'products.option' | t }}</label>
          <select id="Variant-{{ section.id }}" name="id">
            {% for variant in product.variants %}
              <option
                value="{{ variant.id }}"
                {% if variant == current_variant %}
                  selected
                {% endif %}
                {% unless variant.available %}
                  disabled
                {% endunless %}
              >
                {{ variant.title }} - {{ variant.price | money }}
              </option>
            {% endfor %}
          </select>
        </div>
      {% endif %}

      <div class="product__buy">
        <div class="field field--quantity">
          <label for="Quantity-{{ section.id }}">{{ 'products.quantity' | t }}</label>
          <input
            id="Quantity-{{ section.id }}"
            type="number"
            name="quantity"
            min="1"
            value="1"
            inputmode="numeric"
          >
        </div>

        <button class="button product__add" type="submit" name="add" {% unless current_variant.available %}disabled{% endunless %}>
          {% if current_variant.available %}
            {{ 'products.add_to_cart' | t }}
          {% else %}
            {{ 'products.sold_out' | t }}
          {% endif %}
        </button>

        <button
          class="icon-button icon-button--large"
          type="button"
          aria-pressed="false"
          aria-label="{{ 'products.save' | t: title: product.title | escape }}"
          data-save
          data-product="{{ view_json | escape }}"
        >
          {{ 'icon-heart.svg' | inline_asset_content }}
        </button>
      </div>
    {% endform %}

    {% if app_facts != blank and app_facts.size > 0 %}
      <section class="key-facts" aria-labelledby="KeyFacts-{{ section.id }}">
        <h2 id="KeyFacts-{{ section.id }}" class="key-facts__title" data-read>{{ 'products.key_facts' | t }}</h2>
        <div class="rte">
          <ul>
            {% for fact in app_facts %}
              <li>
                {%- if fact.label != blank -%}
                  {{ fact.label | escape }}: {{ fact.value | escape }}
                {%- else -%}
                  {{ fact.value | escape }}
                {%- endif -%}
              </li>
            {% endfor %}
          </ul>
        </div>
      </section>
    {% elsif facts != blank %}
      <section class="key-facts" aria-labelledby="KeyFacts-{{ section.id }}">
        <h2 id="KeyFacts-{{ section.id }}" class="key-facts__title" data-read>{{ 'products.key_facts' | t }}</h2>
        <div class="rte">{{ facts }}</div>
      </section>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .breadcrumb {
    padding-block: 1.25rem 0;
    font-size: 0.9375rem;
  }
  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .breadcrumb li + li::before {
    content: '/';
    margin-right: 0.5rem;
  }
  .product {
    display: grid;
    gap: 2rem;
    padding-block: 1.5rem clamp(3rem, 7vw, 5rem);
  }
  .product__images {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .product__thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .product__thumb {
    display: block;
    width: 5rem;
    padding: 0;
    overflow: hidden;
    border: 1.5px solid var(--color-foreground);
    border-radius: 0.875rem;
    background-color: var(--color-panel);
    cursor: pointer;
    opacity: 0.6;
  }
  .product__thumb img {
    display: block;
    width: 100%;
    height: auto;
  }
  .product__thumb:hover,
  .product__thumb[aria-current='true'] {
    opacity: 1;
  }
  .product__thumb[aria-current='true'] {
    outline: 3px solid var(--color-foreground);
    outline-offset: 2px;
  }
  .product__images img,
  .product__placeholder {
    width: 100%;
    overflow: hidden;
    border: 1.5px solid var(--color-foreground);
    border-radius: 1.5rem;
    background-color: var(--color-panel);
  }
  .product__placeholder svg {
    width: 100%;
    aspect-ratio: 1;
  }
  .product__title {
    margin-block: 0.5rem 1rem;
    font-size: clamp(2.25rem, 5vw, 4rem);
  }
  .product__rating {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .product__price {
    font-family: var(--font-heading--family);
    font-size: 1.75rem;
    font-weight: 700;
  }
  .product__compare {
    margin-left: 0.5rem;
    font-size: 1.125rem;
    font-weight: 400;
  }
  .product__summary {
    max-width: 44ch;
    font-size: 1.1875rem;
  }
  .listen {
    display: none;
    margin-top: 1rem;
  }
  .a11y-listen .listen {
    display: block;
  }
  .product__form {
    margin-block: 1.5rem 2rem;
  }
  .product__buy {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 1rem;
  }
  .product__add {
    flex: 1;
    min-width: 12rem;
    min-height: 3.5rem;
  }
  /* A pale tint of the teal: one part teal to three parts white. Dark text on it is about 15:1. */
  .key-facts {
    padding: 1.5rem;
    border-radius: 1.25rem;
    background-color: color-mix(in srgb, var(--color-highlight) 25%, var(--color-background));
    color: var(--color-foreground);
  }
  .key-facts__title {
    margin-bottom: 0.75rem;
    font-size: 1.375rem;
  }
  .key-facts ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .key-facts li {
    padding-block: 0.375rem;
  }
  /* Phones: quantity, Add to cart and Save share one row. */
  @media (max-width: 35.99rem) {
    .product__buy {
      flex-wrap: nowrap;
      gap: 0.5rem;
    }
    .product__buy .field--quantity input {
      width: 4.25rem;
    }
    .product__add {
      min-width: 0;
      padding-inline: 1rem;
    }
  }
  @media (min-width: 60rem) {
    .product {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: start;
    }
    .product__info {
      position: sticky;
      top: 1.5rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  // Photo previews: show one large photo at a time and switch with the small ones under it.
  (() => {
    const thumbs = document.querySelector('[data-gallery-thumbs]');
    if (!thumbs) return;

    const photos = [...document.querySelectorAll('[data-gallery-photo]')];
    const buttons = [...thumbs.querySelectorAll('button')];

    function show(index) {
      photos.forEach((photo, i) => (photo.hidden = i !== index));
      // Photos that start hidden are lazy-loaded, so ask for this one now.
      photos[index].querySelector('img').loading = 'eager';
      buttons.forEach((button, i) => {
        if (i === index) button.setAttribute('aria-current', 'true');
        else button.removeAttribute('aria-current');
      });
    }

    buttons.forEach((button, index) => button.addEventListener('click', () => show(index)));
    thumbs.hidden = false;
    show(0);
  })();

  // Read it to me: reads the title, price, summary and key facts with the browser's own voice.
  (() => {
    const box = document.querySelector('[data-listen]');
    if (!box || !('speechSynthesis' in window)) return;

    const synth = window.speechSynthesis;
    const button = box.querySelector('[data-listen-button]');
    const label = box.querySelector('[data-listen-label]');
    const status = box.querySelector('[data-listen-status]');
    let speaking = false;

    // One short piece per element. Long single utterances get cut off in some browsers.
    function pieces() {
      return [...document.querySelectorAll('[data-read], .key-facts li')]
        .map((node) => node.innerText.replace(/\s+/g, ' ').trim())
        .filter(Boolean);
    }

    function stop() {
      speaking = false;
      synth.cancel();
      label.textContent = label.dataset.listen;
      button.setAttribute('aria-pressed', 'false');
      status.textContent = '';
    }

    function start() {
      synth.cancel();
      speaking = true;
      label.textContent = label.dataset.stop;
      button.setAttribute('aria-pressed', 'true');
      status.textContent = status.dataset.reading;

      const list = pieces();
      list.forEach((text, index) => {
        const utterance = new SpeechSynthesisUtterance(text);
        utterance.lang = document.documentElement.lang || 'en';
        if (index === list.length - 1) {
          utterance.onend = () => {
            if (speaking) stop();
          };
        }
        synth.speak(utterance);
      });
    }

    button.addEventListener('click', () => (speaking ? stop() : start()));
    // Pointing at other text takes over the voice, so reset this button.
    document.addEventListener('roam:speech-cancel', () => {
      if (speaking) stop();
    });
    window.addEventListener('pagehide', () => synth.cancel());
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
