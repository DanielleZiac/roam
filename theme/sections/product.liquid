{% comment %}
  Product page: photos, a plain-language summary, price, the add-to-cart form
  and a "Key facts" card with the specs.

  The description is written as one summary paragraph followed by a bullet list.
  We split it at the list so the summary sits by the price and the bullets
  become the Key facts card.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign type_handle = product.type | handleize
  assign type_collection = collections[type_handle]
  assign description_parts = product.description | split: '<ul>'
  assign summary = description_parts | first
  if description_parts.size > 1
    assign facts = product.description | remove_first: summary
  endif
%}

{% liquid
  assign view_price = product.price | money
  assign view_image = nil
  if product.featured_image
    assign view_image = product.featured_image | image_url: width: 600, height: 600, crop: 'center'
  endif
%}
{%- capture view_json -%}
  {
    "handle": {{ product.handle | json }},
    "title": {{ product.title | json }},
    "url": {{ product.url | json }},
    "type": {{ product.type | json }},
    "price": {{ view_price | json }},
    "image": {{ view_image | json }},
    "variant": {{ current_variant.id | json }},
    "quickAdd": {% if product.available and product.has_only_default_variant %}true{% else %}false{% endif %}
  }
{%- endcapture -%}
{% # Read by assets/roam-shop.js to remember this product as recently viewed. %}
<script type="application/json" data-product-view>{{ view_json }}</script>

<nav class="breadcrumb" aria-label="{{ 'accessibility.breadcrumb' | t }}">
  <ol role="list">
    <li><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a></li>
    {% if type_collection.url %}
      <li><a href="{{ type_collection.url }}">{{ type_collection.title }}</a></li>
    {% endif %}
    <li aria-current="page">{{ product.title }}</li>
  </ol>
</nav>

<div class="product">
  <div class="product__media">
    {% if product.featured_image %}
      <ul class="product__images" role="list">
        {% for image in product.images %}
          {% liquid
            assign loading = 'lazy'
            if forloop.first
              assign loading = 'eager'
            endif
          %}
          <li>
            {{
              image
              | image_url: width: 1400
              | image_tag: loading: loading, sizes: '(min-width: 60rem) 50vw, 100vw', widths: '500, 800, 1100, 1400'
            }}
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <div class="product__placeholder">
        {{ 'product-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="product__info">
    {% if product.type != blank %}
      <p class="label">{{ product.type }}</p>
    {% endif %}

    <h1 class="product__title" data-read>{{ product.title }}</h1>

    <p class="product__price" data-read>
      <span class="visually-hidden">{{ 'products.price' | t }}</span>
      {{ current_variant.price | money }}
      {% if current_variant.compare_at_price > current_variant.price %}
        <s class="product__compare">
          <span class="visually-hidden">{{ 'products.was' | t }}</span>
          {{ current_variant.compare_at_price | money }}
        </s>
      {% endif %}
    </p>

    {% if summary != blank %}
      <div class="product__summary rte" data-read>{{ summary }}</div>
    {% endif %}

    {% # Shown only when "Read it to me" is switched on in the Accessibility panel. %}
    <div class="listen" data-listen>
      <button class="button button--secondary button--small" type="button" aria-pressed="false" data-listen-button>
        <span data-listen-label data-listen="{{ 'products.listen' | t }}" data-stop="{{ 'products.listen_stop' | t }}">
          {{- 'products.listen' | t -}}
        </span>
      </button>
      <span class="visually-hidden" role="status" data-listen-status data-reading="{{ 'products.listen_reading' | t }}"></span>
    </div>

    {% form 'product', product, class: 'product__form', data-handle: product.handle %}
      {% if product.has_only_default_variant %}
        <input type="hidden" name="id" value="{{ current_variant.id }}">
      {% else %}
        <div class="field">
          <label for="Variant-{{ section.id }}">{{ 'products.option' | t }}</label>
          <select id="Variant-{{ section.id }}" name="id">
            {% for variant in product.variants %}
              <option
                value="{{ variant.id }}"
                {% if variant == current_variant %}
                  selected
                {% endif %}
                {% unless variant.available %}
                  disabled
                {% endunless %}
              >
                {{ variant.title }} - {{ variant.price | money }}
              </option>
            {% endfor %}
          </select>
        </div>
      {% endif %}

      <div class="product__buy">
        <div class="field field--quantity">
          <label for="Quantity-{{ section.id }}">{{ 'products.quantity' | t }}</label>
          <input
            id="Quantity-{{ section.id }}"
            type="number"
            name="quantity"
            min="1"
            value="1"
            inputmode="numeric"
          >
        </div>

        <button class="button product__add" type="submit" name="add" {% unless current_variant.available %}disabled{% endunless %}>
          {% if current_variant.available %}
            {{ 'products.add_to_cart' | t }}
          {% else %}
            {{ 'products.sold_out' | t }}
          {% endif %}
        </button>

        <button
          class="icon-button icon-button--large"
          type="button"
          aria-pressed="false"
          aria-label="{{ 'products.save' | t: title: product.title | escape }}"
          data-save
          data-product="{{ view_json | escape }}"
        >
          {{ 'icon-heart.svg' | inline_asset_content }}
        </button>
      </div>
    {% endform %}

    {% if facts != blank %}
      <section class="key-facts scheme-panel" aria-labelledby="KeyFacts-{{ section.id }}">
        <h2 id="KeyFacts-{{ section.id }}" class="key-facts__title" data-read>{{ 'products.key_facts' | t }}</h2>
        <div class="rte">{{ facts }}</div>
      </section>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .breadcrumb {
    padding-block: 1.25rem 0;
    font-size: 0.9375rem;
  }
  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .breadcrumb li + li::before {
    content: '/';
    margin-right: 0.5rem;
  }
  .product {
    display: grid;
    gap: 2rem;
    padding-block: 1.5rem clamp(3rem, 7vw, 5rem);
  }
  .product__images {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .product__images img,
  .product__placeholder {
    width: 100%;
    overflow: hidden;
    border: 1.5px solid var(--color-foreground);
    border-radius: 1.5rem;
    background-color: var(--color-panel);
  }
  .product__placeholder svg {
    width: 100%;
    aspect-ratio: 1;
  }
  .product__title {
    margin-block: 0.5rem 1rem;
    font-size: clamp(2.25rem, 5vw, 4rem);
  }
  .product__price {
    font-family: var(--font-heading--family);
    font-size: 1.75rem;
    font-weight: 700;
  }
  .product__compare {
    margin-left: 0.5rem;
    font-size: 1.125rem;
    font-weight: 400;
  }
  .product__summary {
    max-width: 44ch;
    font-size: 1.1875rem;
  }
  .listen {
    display: none;
    margin-top: 1rem;
  }
  .a11y-listen .listen {
    display: block;
  }
  .product__form {
    margin-block: 1.5rem 2rem;
  }
  .product__buy {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 1rem;
  }
  .product__add {
    flex: 1;
    min-width: 12rem;
    min-height: 3.5rem;
  }
  .key-facts {
    padding: 1.5rem;
    border-radius: 1.25rem;
  }
  .key-facts__title {
    margin-bottom: 0.75rem;
    font-size: 1.375rem;
  }
  .key-facts ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .key-facts li {
    padding-block: 0.625rem;
    border-top: 1.5px solid var(--color-foreground);
  }
  /* Phones: quantity, Add to cart and Save share one row. */
  @media (max-width: 35.99rem) {
    .product__buy {
      flex-wrap: nowrap;
      gap: 0.5rem;
    }
    .product__buy .field--quantity input {
      width: 4.25rem;
    }
    .product__add {
      min-width: 0;
      padding-inline: 1rem;
    }
  }
  @media (min-width: 60rem) {
    .product {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: start;
    }
    .product__info {
      position: sticky;
      top: 1.5rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  // Read it to me: reads the title, price, summary and key facts with the browser's own voice.
  (() => {
    const box = document.querySelector('[data-listen]');
    if (!box || !('speechSynthesis' in window)) return;

    const synth = window.speechSynthesis;
    const button = box.querySelector('[data-listen-button]');
    const label = box.querySelector('[data-listen-label]');
    const status = box.querySelector('[data-listen-status]');
    let speaking = false;

    // One short piece per element. Long single utterances get cut off in some browsers.
    function pieces() {
      return [...document.querySelectorAll('[data-read], .key-facts li')]
        .map((node) => node.innerText.replace(/\s+/g, ' ').trim())
        .filter(Boolean);
    }

    function stop() {
      speaking = false;
      synth.cancel();
      label.textContent = label.dataset.listen;
      button.setAttribute('aria-pressed', 'false');
      status.textContent = '';
    }

    function start() {
      synth.cancel();
      speaking = true;
      label.textContent = label.dataset.stop;
      button.setAttribute('aria-pressed', 'true');
      status.textContent = status.dataset.reading;

      const list = pieces();
      list.forEach((text, index) => {
        const utterance = new SpeechSynthesisUtterance(text);
        utterance.lang = document.documentElement.lang || 'en';
        if (index === list.length - 1) {
          utterance.onend = () => {
            if (speaking) stop();
          };
        }
        synth.speak(utterance);
      });
    }

    button.addEventListener('click', () => (speaking ? stop() : start()));
    // Pointing at other text takes over the voice, so reset this button.
    document.addEventListener('roam:speech-cancel', () => {
      if (speaking) stop();
    });
    window.addEventListener('pagehide', () => synth.cancel());
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
