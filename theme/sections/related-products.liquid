{% comment %}
  Product page: other products from the same need group (the product's type),
  leaving out the one being viewed.
{% endcomment %}

{% liquid
  assign type_handle = product.type | handleize
  assign related_collection = collections[type_handle]
  assign shown = 0
%}

{% if related_collection.products_count > 1 %}
  <div class="related full-width scheme-{{ section.settings.color_scheme }}">
    <div class="related__inner">
      <div class="related__header">
        <h2>{{ section.settings.heading }} {{ related_collection.title }}</h2>
        <a class="related__link" href="{{ related_collection.url }}">{{ 'products.view_all' | t }}</a>
      </div>

      <ul class="product-grid" role="list">
        {% for related in related_collection.products %}
          {% if related.id != product.id and shown < 4 %}
            {% assign shown = shown | plus: 1 %}
            <li>{% render 'product-card', product: related %}</li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .related__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding: clamp(3rem, 7vw, 5rem) var(--page-margin);
  }
  .related__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-bottom: 2rem;
  }
  .related__link {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    font-weight: bold;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Related products",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "The need group's name is added after it.",
      "default": "More in"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour block",
      "options": [
        { "value": "panel", "label": "Soft lilac" },
        { "value": "plain", "label": "White" },
        { "value": "highlight", "label": "Bright teal" }
      ],
      "default": "panel"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
