{% comment %}
  Site header.

  Wide screens: logo, menu links, then Accessibility, search, wishlist, account and cart.

  Phones and small tablets: logo on the left; search and a menu button on the right.
  The menu button opens a small dropdown under it with Account, Cart, Wishlist,
  Accessibility (which opens the accessibility panel) and the menu links. The dropdown comes after the
  button in the markup, so keyboard focus moves from the button straight into it.

  Without JavaScript the menu button never appears and the full bar stays visible.
{% endcomment %}

{% liquid
  if cart.item_count > 0
    assign cart_label = 'cart.link_count' | t: count: cart.item_count
  else
    assign cart_label = 'cart.link_empty' | t
  endif
%}

<header class="header full-width" data-header>
  <div class="header__inner">
    <a class="header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      {{ 'logo-roam.svg' | inline_asset_content }}
    </a>

    <nav class="header__menu" aria-label="{{ 'accessibility.main_menu' | t }}">
      <ul>
        {% for link in section.settings.menu.links %}
          <li>
            <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title }}</a>
          </li>
        {% endfor %}
        <li class="header__needs">
          {% comment %} The need-group collections, in a native disclosure so it works without JavaScript. {% endcomment %}
          <details data-header-needs>
            <summary>
              {{ 'general.shop_by_need' | t }}
              {{ 'icon-chevron-down.svg' | inline_asset_content }}
            </summary>
            <ul>
              {% for collection in collections %}
                {% unless collection.handle == 'frontpage' or collection.handle == 'all' %}
                  <li><a href="{{ collection.url }}">{{ collection.title }}</a></li>
                {% endunless %}
              {% endfor %}
            </ul>
          </details>
        </li>
      </ul>
    </nav>

    <div class="header__icons">
      {% render 'accessibility-panel' %}

      <a
        class="header__search-link"
        href="{{ routes.all_products_collection_url }}#catalog-search"
        aria-label="{{ 'search.label' | t }}"
      >
        {{ 'icon-search.svg' | inline_asset_content }}
      </a>

      <button class="header__saved header__wide-only" type="button" aria-haspopup="dialog" hidden data-saved-open>
        {{ 'icon-heart.svg' | inline_asset_content }}
        <span class="header__cart-count" aria-hidden="true" hidden data-saved-count></span>
      </button>

      <a class="header__cart header__wide-only" href="{{ routes.cart_url }}" aria-label="{{ cart_label }}" data-cart-link>
        {{ 'icon-shopping-bag.svg' | inline_asset_content }}
        {% if cart.item_count > 0 %}
          <span class="header__cart-count" aria-hidden="true" data-cart-count>{{ cart.item_count }}</span>
        {% endif %}
      </a>

      {% if shop.customer_accounts_enabled %}
        <a class="header__wide-only" href="{{ routes.account_url }}" aria-label="{{ 'accessibility.account' | t }}">
          {{ 'icon-user.svg' | inline_asset_content }}
        </a>
      {% endif %}

      <button
        class="header__menu-button"
        type="button"
        aria-expanded="false"
        aria-controls="HeaderPanel"
        aria-label="{{ 'accessibility.menu_button' | t }}"
        hidden
        data-menu-button
      >
        {{ 'icon-menu.svg' | inline_asset_content }}
        {% # A dot on the menu button says there is something in the cart, since the cart sits inside the menu. %}
        <span class="header__menu-dot" {% if cart.item_count == 0 %}hidden{% endif %} data-menu-dot></span>
      </button>
    </div>

    <div class="header__panel" id="HeaderPanel" hidden data-menu-panel>
      <ul class="header__panel-list" role="list">
        <li>
          <a class="header__cart" href="{{ routes.cart_url }}" aria-label="{{ cart_label }}" data-cart-link>
            {{ 'icon-shopping-bag.svg' | inline_asset_content }}
            {{ 'cart.title' | t }}
            {% if cart.item_count > 0 %}
              <span class="header__cart-count" aria-hidden="true" data-cart-count>{{ cart.item_count }}</span>
            {% endif %}
          </a>
        </li>
        {% if shop.customer_accounts_enabled %}
          <li>
            <a href="{{ routes.account_url }}">
              {{ 'icon-user.svg' | inline_asset_content }}
              {{ 'accessibility.account' | t }}
            </a>
          </li>
        {% endif %}
        <li>
          <button type="button" aria-haspopup="dialog" data-saved-open>
            {{ 'icon-heart.svg' | inline_asset_content }}
            {{ 'saved.title' | t }}
            <span class="header__cart-count" aria-hidden="true" hidden data-saved-count></span>
          </button>
        </li>
        <li>
          {% # Opens the same Accessibility panel as the button in the wide-screen header. %}
          <button type="button" aria-haspopup="dialog" data-a11y-open>
            {{ 'icon-accessibility.svg' | inline_asset_content }}
            {{ 'accessibility.panel_button' | t }}
          </button>
        </li>
        <li>
          {% comment %} The need-group collections, folded away until asked for. {% endcomment %}
          <details class="header__panel-needs">
            <summary>
              {{ 'icon-layout-grid.svg' | inline_asset_content }}
              {{ 'general.shop_by_need' | t }}
              <span class="header__panel-chevron" aria-hidden="true">
                {{- 'icon-chevron-down.svg' | inline_asset_content -}}
              </span>
            </summary>
            <ul role="list">
              {% for collection in collections %}
                {% unless collection.handle == 'frontpage' or collection.handle == 'all' %}
                  <li><a href="{{ collection.url }}">{{ collection.title }}</a></li>
                {% endunless %}
              {% endfor %}
            </ul>
          </details>
        </li>
      </ul>

      <ul class="header__panel-list" role="list">
        {% comment %}
          The logo already goes home and the search icon goes to the catalog,
          so those two links are left out of this list.
        {% endcomment %}
        {% for link in section.settings.menu.links %}
          {% unless link.url == routes.root_url or link.url == routes.all_products_collection_url %}
            <li>
              <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>
                {% if link.url contains 'contact' %}
                  {{ 'icon-mail.svg' | inline_asset_content }}
                {% else %}
                  {{ 'icon-chevron-right.svg' | inline_asset_content }}
                {% endif %}
                {{ link.title }}
              </a>
            </li>
          {% endunless %}
        {% endfor %}
      </ul>
    </div>
  </div>
</header>

{% stylesheet %}
  .header {
    border-bottom: 2px solid var(--color-foreground);
  }
  .header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    max-width: var(--page-width);
    margin-inline: auto;
    padding: 0.75rem var(--page-margin);
  }
  .header a {
    text-decoration: none;
  }
  .header__logo {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    color: var(--color-foreground);
  }
  .header__logo svg {
    width: auto;
    height: 1.75rem;
  }
  .header__menu ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .header__menu a {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding-inline: 0.75rem;
    color: var(--color-foreground);
    font-weight: 500;
  }
  .header__menu a:hover,
  .header__menu a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 0.18em;
    text-decoration-color: var(--color-action);
    text-underline-offset: 0.4em;
  }
  .header__needs details {
    position: relative;
  }
  .header__needs summary {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 3rem;
    padding-inline: 0.75rem;
    font-weight: 500;
    list-style: none;
    cursor: pointer;
  }
  .header__needs summary::-webkit-details-marker {
    display: none;
  }
  .header__needs summary svg {
    width: 1.125rem;
    height: 1.125rem;
  }
  .header__needs details[open] summary svg {
    rotate: 180deg;
  }
  .header__needs details ul {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 20;
    display: grid;
    gap: 0;
    min-width: 16rem;
    padding: 0.5rem;
    border: 1.5px solid var(--color-foreground);
    border-radius: 1rem;
    background-color: var(--color-background);
  }
  .header__needs details ul a {
    display: flex;
    min-height: 2.75rem;
    border-radius: 0.5rem;
  }
  .header__icons {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .header__icons > a,
  .header__saved,
  .header__menu-button {
    position: relative;
    display: inline-grid;
    place-items: center;
    min-width: 3rem;
    min-height: 3rem;
    border: 0;
    background: none;
    color: var(--color-foreground);
    cursor: pointer;
  }
  .header__icons > a svg,
  .header__saved svg,
  .header__menu-button svg {
    width: 1.5rem;
    height: 1.5rem;
  }
  .header__cart-count {
    position: absolute;
    top: 0;
    right: 0;
    min-width: 1.5rem;
    padding: 0 0.3rem;
    border-radius: 1rem;
    background-color: var(--color-highlight);
    color: var(--color-foreground);
    font-size: 0.875rem;
    font-weight: bold;
    line-height: 1.5rem;
    text-align: center;
  }
  .header__menu-dot {
    position: absolute;
    top: 0.5rem;
    right: 0.375rem;
    width: 0.75rem;
    height: 0.75rem;
    border: 2px solid var(--color-background);
    border-radius: 50%;
    background-color: var(--color-action);
  }

  /*
   * The menu dropdown: a small card that hangs from the right end of the bar and
   * floats over the page. Rows of links and buttons, each at least 48px tall.
   */
  .header__inner {
    position: relative;
  }
  .header__panel {
    position: absolute;
    top: 100%;
    right: var(--page-margin);
    z-index: 50;
    width: min(17rem, calc(100% - var(--page-margin) * 2));
    margin-top: 0.375rem;
    padding: 0.5rem 0.75rem;
    border: 2px solid var(--color-foreground);
    border-radius: 1rem;
    background-color: var(--color-background);
    box-shadow: 0 0.5rem 1.5rem rgb(16 20 24 / 0.18);
  }
  .header__panel-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .header__panel-list a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 0.18em;
    text-decoration-color: var(--color-action);
    text-underline-offset: 0.3em;
  }
  .header__panel svg {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
  }
  .header__panel .header__cart-count {
    position: static;
    margin-left: auto;
  }
  .header__panel-list :is(a, button, summary) {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    min-height: 3rem;
    padding: 0 0.25rem;
    border: 0;
    background: none;
    color: var(--color-foreground);
    font: inherit;
    font-size: 1.125rem;
    font-weight: 500;
    text-align: left;
    cursor: pointer;
  }
  .header__panel-needs summary {
    list-style: none;
  }
  .header__panel-needs summary::-webkit-details-marker {
    display: none;
  }
  .header__panel-chevron {
    display: inline-flex;
    margin-left: auto;
  }
  .header__panel-needs[open] .header__panel-chevron {
    rotate: 180deg;
  }
  .header__panel-needs ul {
    margin: 0;
    padding: 0 0 0.25rem 2.25rem;
    list-style: none;
  }
  .header__panel-needs ul a {
    min-height: 2.75rem;
    font-size: 1rem;
    font-weight: 400;
  }

  /* Wide screens never show the menu button or its panel. */
  @media (min-width: 48rem) {
    .header__menu-button,
    .header__panel {
      display: none !important;
    }
  }

  /* Phones and small tablets: logo, search and the menu button only. */
  @media (max-width: 47.99rem) {
    .header__inner {
      gap: 0 0.25rem;
      padding-block: 0.5rem;
    }
    .header__logo svg {
      height: 1.5rem;
    }
    .header__icons {
      gap: 0;
    }
    .header.has-menu-button :is(.header__menu, .header__wide-only, .a11y-trigger) {
      display: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  // Shop by need: close the list on Escape or when the pointer or focus goes elsewhere.
  (() => {
    const needs = document.querySelector('[data-header-needs]');
    if (!needs) return;
    document.addEventListener('click', (event) => {
      if (!needs.contains(event.target)) needs.open = false;
    });
    needs.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !needs.open) return;
      needs.open = false;
      needs.querySelector('summary').focus();
    });
    needs.addEventListener('focusout', (event) => {
      if (event.relatedTarget && !needs.contains(event.relatedTarget)) needs.open = false;
    });
  })();

  // Phone menu: the button shows and hides the panel.
  (() => {
    const header = document.querySelector('[data-header]');
    const button = header && header.querySelector('[data-menu-button]');
    const panel = header && header.querySelector('[data-menu-panel]');
    if (!button || !panel) return;

    header.classList.add('has-menu-button');
    button.hidden = false;

    function setOpen(open) {
      panel.hidden = !open;
      button.setAttribute('aria-expanded', String(open));
    }

    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));

    // A click or tap anywhere outside the dropdown closes it.
    document.addEventListener('click', (event) => {
      if (panel.hidden || panel.contains(event.target) || button.contains(event.target)) return;
      // The wishlist and accessibility dialogs open on top; leave the menu as it is while they are used.
      if (event.target.closest('dialog')) return;
      setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        button.focus();
      }
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "t:labels.menu"
    }
  ]
}
{% endschema %}
