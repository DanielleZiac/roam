{% comment %}
  A band of large scrolling links. Each word is a block with its own link.

  The words are printed twice so the loop is seamless. The first copy is a real
  list of links; the second is hidden from screen readers and the keyboard.
  The band only moves if the visitor allows motion, and it stops while the
  pointer is over it or a link in it has keyboard focus. No JavaScript.
{% endcomment %}

<div class="ticker full-width scheme-{{ section.settings.color_scheme }}" data-no-hover-read>
  <div class="ticker__track">
    {% for copy in (1..2) %}
      <ul
        class="ticker__group"
        role="list"
        {% if copy == 2 %}
          aria-hidden="true"
        {% endif %}
      >
        {% for block in section.blocks %}
          <li
            {% if copy == 1 %}
              {{ block.shopify_attributes }}
            {% endif %}
          >
            <a
              class="ticker__item heading"
              href="{{ block.settings.link | default: routes.all_products_collection_url }}"
              {% if copy == 2 %}
                tabindex="-1"
              {% endif %}
            >
              {{- block.settings.text -}}
            </a>
            <span class="ticker__dot" aria-hidden="true"></span>
          </li>
        {% endfor %}
      </ul>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .ticker {
    overflow: hidden;
    padding-block: 0.75rem;
  }
  .ticker__track {
    display: flex;
  }
  .ticker__group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0 1.5rem;
    margin: 0;
    padding: 0 var(--page-margin);
    list-style: none;
  }
  /* The second copy only exists for the moving loop. */
  .ticker__group[aria-hidden='true'] {
    display: none;
  }
  .ticker__group li {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .ticker__item {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    color: inherit;
    font-size: clamp(1.5rem, 4vw, 2.75rem);
    text-decoration: none;
    white-space: nowrap;
  }
  .ticker__item:hover,
  .ticker__item:focus-visible {
    text-decoration: underline;
    text-decoration-color: var(--scheme-accent);
    text-decoration-thickness: 0.12em;
    text-underline-offset: 0.18em;
  }
  .ticker__dot {
    width: 0.75rem;
    height: 0.75rem;
    flex: none;
    border-radius: 50%;
    background-color: var(--scheme-accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .ticker__track {
      width: max-content;
      animation: ticker 40s linear infinite;
    }
    .ticker__group,
    .ticker__group[aria-hidden='true'] {
      display: flex;
      flex-wrap: nowrap;
      padding: 0 1.5rem 0 0;
    }
    /* Stops while a link in the band has keyboard focus. */
    .ticker:focus-within .ticker__track {
      animation-play-state: paused;
    }
  }
  /* Also stops under a mouse pointer. Touch screens are left out: there a tap leaves hover stuck on. */
  @media (prefers-reduced-motion: no-preference) and (hover: hover) {
    .ticker:hover .ticker__track {
      animation-play-state: paused;
    }
  }
  @keyframes ticker {
    to {
      transform: translateX(-50%);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Scrolling words",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour block",
      "options": [
        { "value": "dark", "label": "Dark" },
        { "value": "highlight", "label": "Bright teal" },
        { "value": "action", "label": "Violet" },
        { "value": "panel", "label": "Soft lilac" }
      ],
      "default": "dark"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Word",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Power assist"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Scrolling words",
      "blocks": [
        { "type": "item", "settings": { "text": "Power assist" } },
        { "type": "item", "settings": { "text": "Sports wheels" } },
        { "type": "item", "settings": { "text": "Braille keys" } }
      ]
    }
  ]
}
{% endschema %}
