{% comment %}
  "Shop by need": the store's need groups as large cards, each linking to its
  collection. This is the clearest statement of who Roam is for, so it sits
  directly under the hero. Each card is a block that points at a collection;
  the title and product count come from the collection itself. The picture is
  the block's own image, or its chosen product's photo, or the collection's
  image, or the collection's first product's photo. Hovering
  a card turns it violet and swaps the picture for the short description.
{% endcomment %}

<div class="needs" id="shop-by-need">
  <div class="needs__intro">
    <h2>{{ section.settings.heading }}</h2>
    {% if section.settings.text != blank %}
      <p>{{ section.settings.text }}</p>
    {% endif %}
  </div>

  <ul class="needs__list" role="list">
    {% for block in section.blocks %}
      {% assign need = block.settings.collection %}
      {% if need.url %}
        {% assign need_image = block.settings.image | default: block.settings.product.featured_image | default: need.featured_image | default: need.products.first.featured_image %}
        <li class="need{% if block.settings.text != blank %} need--has-text{% endif %}" {{ block.shopify_attributes }}>
          <h3 class="need__title">
            <a href="{{ need.url }}">
              {%- render 'need-icon', group: need.handle -%}
              {{ block.settings.title | default: need.title }}
            </a>
          </h3>
          <div class="need__body">
            {% if need_image %}
              {% # Decorative: the title already names the group, so the picture has no alt text. %}
              <div class="need__media">
                {{
                  need_image
                  | image_url: width: 600
                  | image_tag: loading: 'lazy', alt: '', sizes: '(min-width: 64rem) 16vw, (min-width: 36rem) 40vw, 3rem', widths: '100, 200, 400, 600'
                }}
              </div>
            {% endif %}
            {% if block.settings.text != blank %}
              {% # Shown in place of the picture on hover: the description, with the group's icon centred below it. %}
              <div class="need__reveal">
                <p class="need__text">{{ block.settings.text }}</p>
                <div class="need__reveal-icon">{% render 'need-icon', group: need.handle %}</div>
              </div>
            {% endif %}
          </div>
          <p class="need__count">
            {{ 'collections.count' | t: count: need.products_count }}
            <span aria-hidden="true">&rarr;</span>
          </p>
        </li>
      {% endif %}
    {% endfor %}
  </ul>
</div>

{% stylesheet %}
  .needs {
    padding-block: clamp(3rem, 7vw, 5rem);
    scroll-margin-top: 1rem;
  }
  .needs__intro {
    max-width: 44rem;
    margin-bottom: 2rem;
  }
  .needs__intro h2 {
    margin-bottom: 0.5rem;
  }
  .needs__list {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .need {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem;
    border: 2px solid var(--color-foreground);
    border-radius: 1.25rem;
    background-color: var(--color-background);
  }
  .need__title {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
  }
  /* The title follows the card's text colour, so it turns white with the card on hover. */
  .need__title {
    color: inherit;
  }
  .need__title a {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
  }
  /* The icon lines up with the first line of the name. */
  .need__title .need-icon {
    margin-top: 0.1em;
  }
  /* Stretch the link over the whole card. */
  .need__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .need__title a:focus-visible {
    outline: none;
  }
  .need:has(a:focus-visible) {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }
  /* The middle of the card: the picture, with the description lying over it, unseen until the card is hovered. */
  .need__body {
    position: relative;
    display: grid;
    flex: 1;
    place-items: center;
  }
  .need__media {
    display: grid;
    width: 100%;
    place-items: center;
  }
  .need__reveal {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    opacity: 0;
  }
  .need__text {
    margin: 0;
  }
  /* The icon takes the space left under the description, centred in it. */
  .need__reveal-icon {
    display: grid;
    flex: 1;
    place-items: center;
    font-size: 2.75rem;
  }
  /* Multiply blending drops a white photo background, so the product sits on the card itself. */
  .need__media img {
    width: 100%;
    max-width: 12rem;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    mix-blend-mode: multiply;
  }
  .need__count {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: auto 0 0;
    padding-top: 0.75rem;
    border-top: 2px solid var(--color-foreground);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    text-transform: uppercase;
  }
  .need__count span {
    font-size: 1.5rem;
    line-height: 1;
  }
  /*
   * Hover or keyboard focus turns the card violet with white text (7.7:1) and nudges the arrow.
   * A card with a description shows it in place of the picture.
   */
  .need:hover,
  .need:has(a:focus-visible) {
    border-color: var(--color-violet);
    background-color: var(--color-violet);
    color: var(--color-background);
  }
  .need:is(:hover, :has(a:focus-visible)) .need__count {
    border-top-color: currentColor;
  }
  .need--has-text:is(:hover, :has(a:focus-visible)) .need__media {
    opacity: 0;
  }
  .need:is(:hover, :has(a:focus-visible)) .need__reveal {
    opacity: 1;
  }
  .need:hover .need__count span {
    translate: 0.3rem 0;
  }
  /* Phones: each need is one compact row: icon and name, then the count on the right. */
  @media (max-width: 35.99rem) {
    .need {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      min-height: 0;
      padding: 1rem 1.25rem;
    }
    .need__title {
      font-size: 1.25rem;
    }
    .need__title {
      flex: 1;
    }
    /* No picture on phones: the icon beside the name stands for the group. */
    .need__body {
      display: none;
    }
    .need__count {
      flex: none;
      gap: 0.5rem;
      margin: 0;
      padding: 0;
      border: 0;
    }
  }
  /* One column on phones, two on tablets, all five in a row on wide screens. */
  @media (min-width: 36rem) {
    .needs__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .needs__list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    .need {
      padding: 1.25rem;
    }
    /* Big screens: no icon beside the name. It appears on hover, under the description. */
    .need__title .need-icon {
      display: none;
    }
    /* Five narrow cards: the title steps down so one-word names like "Nonspeaking" stay on one line. */
    .need__title {
      font-size: clamp(1.125rem, 1.75vw, 1.75rem);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .need {
      transition:
        background-color 0.15s,
        color 0.15s,
        border-color 0.15s;
    }
    .need__media,
    .need__reveal {
      transition: opacity 0.15s;
    }
    .need__count span {
      transition: translate 0.25s;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop by need",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by need"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Supporting line",
      "default": "Assistive technology for how you move, hear, see, speak and grip."
    }
  ],
  "blocks": [
    {
      "type": "need",
      "name": "Need group",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Leave empty to use the collection's name."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Short description",
          "info": "Shown when the card is hovered."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Picture",
          "info": "Leave empty to use the product chosen below."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product to picture",
          "info": "Its main photo is shown. Leave empty to use the collection's image, or its first product's photo."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Shop by need"
    }
  ]
}
{% endschema %}
