{% comment %}
  "Shop by need": the store's need groups as large cards, each linking to its
  collection. This is the clearest statement of who Roam is for, so it sits
  directly under the hero. Each card is a block that points at a collection;
  the title and product count come from the collection itself.
{% endcomment %}

<div class="needs" id="shop-by-need">
  <div class="needs__intro">
    <h2>{{ section.settings.heading }}</h2>
    {% if section.settings.text != blank %}
      <p>{{ section.settings.text }}</p>
    {% endif %}
  </div>

  <ul class="needs__list" role="list">
    {% for block in section.blocks %}
      {% assign need = block.settings.collection %}
      {% if need.url %}
        <li class="need" {{ block.shopify_attributes }}>
          <h3 class="need__title">
            <a href="{{ need.url }}">{{ block.settings.title | default: need.title }}</a>
          </h3>
          {% if block.settings.text != blank %}
            <p class="need__text">{{ block.settings.text }}</p>
          {% endif %}
          <p class="need__count">
            {{ 'collections.count' | t: count: need.products_count }}
            <span aria-hidden="true">&rarr;</span>
          </p>
        </li>
      {% endif %}
    {% endfor %}
  </ul>
</div>

{% stylesheet %}
  .needs {
    padding-block: clamp(3rem, 7vw, 5rem);
    scroll-margin-top: 1rem;
  }
  .needs__intro {
    max-width: 44rem;
    margin-bottom: 2rem;
  }
  .needs__intro h2 {
    margin-bottom: 0.5rem;
  }
  .needs__list {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .need {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-height: 13rem;
    padding: 1.5rem;
    border: 2px solid var(--color-foreground);
    border-radius: 1.25rem;
    background-color: var(--color-background);
  }
  .need__title {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
  }
  .need__title a {
    color: inherit;
    text-decoration: none;
  }
  /* Stretch the link over the whole card. */
  .need__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .need__title a:focus-visible {
    outline: none;
  }
  .need:has(a:focus-visible) {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }
  .need__text {
    margin: 0;
  }
  .need__count {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: auto 0 0;
    padding-top: 0.75rem;
    border-top: 2px solid var(--color-foreground);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    text-transform: uppercase;
  }
  .need__count span {
    font-size: 1.5rem;
    line-height: 1;
  }
  /* Hover fills the card teal: dark text on teal is 9.8:1. */
  .need:hover {
    background-color: var(--color-highlight);
  }
  /* Phones: each need is one compact row with its name on the left and the count on the right. */
  @media (max-width: 35.99rem) {
    .need {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      min-height: 0;
      padding: 1rem 1.25rem;
    }
    .need__title {
      font-size: 1.25rem;
    }
    .need__text {
      display: none;
    }
    .need__count {
      flex: none;
      gap: 0.5rem;
      margin: 0;
      padding: 0;
      border: 0;
    }
  }
  /* One column on phones, two on tablets, all five in a row on wide screens. */
  @media (min-width: 36rem) {
    .needs__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .needs__list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    .need {
      min-height: 16rem;
      padding: 1.25rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .need {
      transition: background-color 0.15s;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop by need",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by need"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Supporting line",
      "default": "Assistive technology for how you move, hear, see, speak and grip."
    }
  ],
  "blocks": [
    {
      "type": "need",
      "name": "Need group",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Leave empty to use the collection's name."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Short description"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Shop by need"
    }
  ]
}
{% endschema %}
