{% comment %}
  A full-width colour block with one big statement and a button.
  Used on the home page to invite shoppers into "Tell us about you".
{% endcomment %}

<div class="callout full-width scheme-{{ section.settings.color_scheme }}">
  <div class="callout__inner">
    <div class="callout__main">
      {% if section.settings.eyebrow != blank %}
        <p class="label">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% # One span per sentence, so each sentence of the headline keeps to its own line. %}
      {% assign heading_sentences = section.settings.heading | split: '. ' %}
      <h2 class="callout__heading">
        {%- for sentence in heading_sentences -%}
          <span>{{ sentence }}{% unless forloop.last %}.{% endunless %}</span>{% unless forloop.last %} {% endunless %}
        {%- endfor -%}
      </h2>
    </div>

    <div class="callout__side">
      {% if section.settings.text != blank %}
        <p class="callout__text">{{ section.settings.text }}</p>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a class="button" href="{{ section.settings.button_link | default: routes.collections_url }}">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .callout__inner {
    display: grid;
    gap: 1.25rem;
    max-width: var(--page-width);
    margin-inline: auto;
    padding: clamp(2rem, 4vw, 3rem) var(--page-margin);
  }
  /* The headline is sized from its own column, so each sentence fits on one line and never breaks mid-sentence. */
  .callout__main {
    container-type: inline-size;
  }
  .callout__heading {
    font-size: clamp(1.5rem, 8.8cqi, 5.5rem);
    line-height: 1;
  }
  .callout__heading span {
    display: block;
    white-space: nowrap;
  }
  /* The text and button sit under the headline and use the full width, so the text runs in long lines. */
  .callout__text {
    max-width: 70ch;
    margin-bottom: 1.25rem;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Callout",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour block",
      "options": [
        { "value": "action", "label": "Lime accent" },
        { "value": "muted", "label": "White, grey text" },
        { "value": "highlight", "label": "Bright teal" },
        { "value": "panel", "label": "Lime" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "action"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small line above the heading",
      "default": "Optional. Takes a minute."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tell us about you. We'll find your gear."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Answer a few questions about how you move, hear, see and communicate. Your answers stay on your device."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Find my gear"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Callout"
    }
  ]
}
{% endschema %}
