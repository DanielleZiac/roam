{% comment %}
  A row of product cards from one collection, with a link to the full catalog.
{% endcomment %}

{% liquid
  assign featured_collection = section.settings.collection | default: collections.all
%}

<div class="featured full-width scheme-{{ section.settings.color_scheme }}">
  <div class="featured__inner">
  <div class="featured__header">
    <h2>{{ section.settings.heading }}</h2>
    <a class="featured__link" href="{{ routes.all_products_collection_url }}">{{ section.settings.link_label }}</a>
  </div>

  <ul class="product-grid" role="list">
    {% for product in featured_collection.products limit: section.settings.limit %}
      <li>{% render 'product-card', product: product %}</li>
    {% endfor %}
  </ul>
  </div>
</div>

{% stylesheet %}
  .featured__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    /* Less space on top: on the home page this row follows a banner of the same colour. */
    padding: clamp(1rem, 2vw, 1.5rem) var(--page-margin) clamp(3rem, 7vw, 5rem);
  }
  .featured__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-bottom: 2rem;
  }
  .featured__link {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    font-weight: bold;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured products",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Gear people are choosing"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour block",
      "options": [
        { "value": "panel", "label": "Lime" },
        { "value": "plain", "label": "White" },
        { "value": "muted", "label": "White, grey text" },
        { "value": "highlight", "label": "Bright teal" }
      ],
      "default": "panel"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave empty to show all products."
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Number of products",
      "default": 4
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Shop all gear"
    }
  ],
  "presets": [
    {
      "name": "Featured products"
    }
  ]
}
{% endschema %}
