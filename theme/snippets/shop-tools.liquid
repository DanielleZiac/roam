{% doc %}
  Everything assets/roam-shop.js needs on every page: the Saved gear panel,
  icon templates for cards drawn by the script, its text strings, and a
  live region for screen-reader announcements. Rendered once in the layout.

  @example
  {% render 'shop-tools' %}
{% enddoc %}

<dialog class="saved-panel" aria-labelledby="SavedPanelTitle" data-saved-panel>
  <div class="saved-panel__header">
    <h2 id="SavedPanelTitle">{{ 'saved.title' | t }}</h2>
    <button class="close-button" type="button" aria-label="{{ 'accessibility.panel_close' | t }}" data-saved-close>
      {{ 'icon-x.svg' | inline_asset_content }}
    </button>
  </div>
  <p>{{ 'saved.intro' | t }}</p>

  <ul class="product-grid saved-panel__list" role="list" data-saved-list hidden></ul>

  <div class="saved-panel__empty scheme-panel" data-saved-empty>
    <p>{{ 'saved.empty' | t }}</p>
    <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'cart.empty_button' | t }}</a>
  </div>
</dialog>

<template data-icon="heart">{{ 'icon-heart.svg' | inline_asset_content }}</template>
<template data-icon="plus">{{ 'icon-shopping-cart.svg' | inline_asset_content }}</template>
{% # Need group icons, for cards that scripts build: the wishlist, recently viewed and quiz results. %}
{% assign need_groups = 'mobility,hands-and-dexterity,deaf-and-hard-of-hearing,nonspeaking,blind-and-low-vision' | split: ',' %}
{% for need_group in need_groups %}
  <template data-need-icon="{{ need_group }}">{% render 'need-icon', group: need_group %}</template>
{% endfor %}

<p class="visually-hidden" role="status" data-shop-status></p>

{% # A short message that slides up after a quick add or a save. It is a live region, so screen readers hear it too. %}
<div class="shop-toast" role="status" data-shop-toast>
  {{ 'icon-badge-check.svg' | inline_asset_content }}
  <span data-shop-toast-text></span>
  <a href="{{ routes.cart_url }}" data-toast-action="cart" hidden>{{ 'cart.view' | t }}</a>
  <button type="button" data-toast-action="saved" hidden>{{ 'saved.view' | t }}</button>
</div>

<script type="application/json" data-shop-strings>
  {
    "cartAddUrl": {{ routes.cart_add_url | json }},
    "cartUrl": {{ routes.cart_url | append: '.js' | json }},
    "eventsUrl": {{ routes.root_url | append: 'apps/roam/events' | json }},
    "cartEventUrl": {{ routes.root_url | append: 'apps/roam/cart' | json }},
    "save": {{ 'products.save' | t: title: '[title]' | json }},
    "unsave": {{ 'products.unsave' | t: title: '[title]' | json }},
    "quickAdd": {{ 'products.quick_add' | t: title: '[title]' | json }},
    "savedMessage": {{ 'saved.added' | t: title: '[title]' | json }},
    "unsavedMessage": {{ 'saved.removed' | t: title: '[title]' | json }},
    "addedMessage": {{ 'cart.added' | t: title: '[title]' | json }},
    "savedButton": {{ 'saved.button' | t: count: '[count]' | json }},
    "cartOne": {{ 'cart.link_count.one' | t: count: '[count]' | json }},
    "cartOther": {{ 'cart.link_count.other' | t: count: '[count]' | json }}
  }
</script>

{% stylesheet %}
  .shop-toast {
    position: fixed;
    z-index: 50;
    bottom: 1.5rem;
    left: 50%;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: max-content;
    max-width: calc(100% - 2rem);
    padding: 0.875rem 1.25rem;
    border-radius: 1rem;
    background-color: var(--color-dark);
    color: var(--color-background);
    font-weight: 500;
    translate: -50% 1rem;
    visibility: hidden;
    opacity: 0;
  }
  .shop-toast.is-visible {
    translate: -50% 0;
    visibility: visible;
    opacity: 1;
  }
  .shop-toast svg {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--color-highlight);
  }
  /* White on dark is 18.5:1; the link is underlined so it does not rely on colour. */
  .shop-toast :is(a, button) {
    flex: none;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-weight: 700;
    text-decoration: underline;
    cursor: pointer;
  }
  .shop-toast :is(a, button):focus-visible {
    outline: 3px solid var(--color-background);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .shop-toast {
      transition:
        translate 0.2s,
        opacity 0.2s,
        visibility 0.2s;
    }
  }
  .saved-panel {
    width: min(60rem, calc(100% - 2rem));
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: 1.5rem;
    border: 2px solid var(--color-foreground);
    border-radius: 1.5rem;
  }
  .saved-panel::backdrop {
    background-color: rgb(16 20 24 / 0.6);
  }
  .saved-panel__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }
  .saved-panel__list {
    margin-top: 1.5rem;
  }
  .saved-panel__empty {
    margin-top: 1.5rem;
    padding: 2rem;
    border-radius: 1.25rem;
  }
{% endstylesheet %}
