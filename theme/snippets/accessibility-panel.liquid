{% doc %}
  The "Accessibility" button and the panel it opens. Two optional modes, both
  remembered on this device (localStorage) and applied as classes on <html>:

  - a11y-listen: reads any text aloud when the shopper points at it or tabs to it,
    and shows a Listen button on product pages (browser speech). This is a
    point-and-listen aid for low vision and reading difficulties. It is not a
    screen reader replacement: blind shoppers use their own (VoiceOver, TalkBack,
    NVDA, JAWS), which the semantic markup and alt text already support.

  Icons are from Lucide (ISC licence).
  - a11y-dyslexia: plainer font, wider spacing, shorter lines, cream background.

  The store already meets WCAG AA without them; these are extras a shopper
  can switch on. layout/theme.liquid applies saved choices before the page
  paints, so there is no flash when moving between pages.

  @example
  {% render 'accessibility-panel' %}
{% enddoc %}

<button
  class="a11y-trigger"
  type="button"
  aria-haspopup="dialog"
  aria-label="{{ 'accessibility.panel_button' | t }}"
  hidden
  data-a11y-open
>
  {{ 'icon-accessibility.svg' | inline_asset_content }}
  <span class="a11y-trigger__text">{{ 'accessibility.panel_button' | t }}</span>
</button>

<dialog class="a11y-panel" aria-labelledby="A11yPanelTitle" data-a11y-panel>
  <div class="a11y-panel__header">
    <h2 id="A11yPanelTitle">{{ 'accessibility.panel_title' | t }}</h2>
    <button class="close-button" type="button" aria-label="{{ 'accessibility.panel_close' | t }}" data-a11y-close>
      {{ 'icon-x.svg' | inline_asset_content }}
    </button>
  </div>

  <p>{{ 'accessibility.panel_intro' | t }}</p>

  {% comment %}
    Each option is one large label: the icon, the name and the checkbox share the
    first line, with the explanation underneath. The whole box changes colour
    when its option is on.
  {% endcomment %}
  <div class="a11y-options">
    <label class="a11y-option">
      <span class="a11y-option__head">
        <span class="a11y-option__icon" aria-hidden="true">{{ 'icon-eye.svg' | inline_asset_content }}</span>
        <strong class="a11y-option__title">{{ 'accessibility.dyslexia_title' | t }}</strong>
        <input type="checkbox" data-a11y-toggle="dyslexia">
      </span>
      <span class="a11y-option__text">{{ 'accessibility.dyslexia_text' | t }}</span>
    </label>

    <label class="a11y-option">
      <span class="a11y-option__head">
        <span class="a11y-option__icon" aria-hidden="true">{{ 'icon-volume-2.svg' | inline_asset_content }}</span>
        <strong class="a11y-option__title">{{ 'accessibility.listen_title' | t }}</strong>
        <input type="checkbox" data-a11y-toggle="listen">
      </span>
      <span class="a11y-option__text">{{ 'accessibility.listen_text' | t }}</span>
    </label>
  </div>

  <p class="a11y-panel__note" hidden data-a11y-no-speech>{{ 'accessibility.listen_unsupported' | t }}</p>

  <button class="button a11y-panel__done" type="button" data-a11y-close>
    {{ 'accessibility.panel_done' | t }}
  </button>
</dialog>

{% stylesheet %}
  .a11y-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 3rem;
    padding: 0.5rem 1.125rem;
    border: 1.5px solid var(--color-foreground);
    border-radius: 999px;
    background-color: transparent;
    color: var(--color-foreground);
    font: inherit;
    font-weight: 500;
    cursor: pointer;
  }
  .a11y-trigger svg {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
  }
  .a11y-trigger[hidden] {
    display: none;
  }
  .a11y-trigger:hover {
    background-color: var(--color-panel);
  }
  .a11y-panel {
    width: min(30rem, calc(100% - 2rem));
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: 1.5rem;
    border: 2px solid var(--color-foreground);
    border-radius: 1.5rem;
  }
  .a11y-panel::backdrop {
    background-color: rgb(16 20 24 / 0.6);
  }
  .a11y-panel__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }
  .a11y-panel__header h2 {
    font-size: 1.75rem;
  }
  .a11y-options {
    display: grid;
    gap: 0.75rem;
  }
  .a11y-option {
    --option-padding: 1rem;
    display: grid;
    gap: 0.625rem;
    padding: var(--option-padding);
    border: 1.5px solid var(--color-foreground);
    border-radius: 1rem;
    cursor: pointer;
  }
  .a11y-option__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .a11y-option__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background-color: var(--color-panel);
  }
  .a11y-option__icon svg {
    width: 1.5rem;
    height: 1.5rem;
  }
  .a11y-option__title {
    font-size: 1.125rem;
  }
  /*
   * The checkbox sits at the far right of the first line, drawn as a circle:
   * an empty ring when off, a filled dot when on. It is still a real checkbox.
   */
  .a11y-option input {
    appearance: none;
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    min-height: 0;
    margin: 0 0 0 auto;
    padding: 0;
    border: 2px solid var(--color-foreground);
    border-radius: 50%;
    background-color: var(--color-background);
    cursor: pointer;
  }
  .a11y-option input:checked {
    background-color: var(--color-foreground);
    box-shadow: inset 0 0 0 4px var(--color-background);
  }
  .a11y-option input:disabled {
    border-style: dashed;
    cursor: not-allowed;
  }
  /* Phones: tighter spacing so the icon, name and circle stay on one line. */
  @media (max-width: 30rem) {
    .a11y-panel {
      padding: 1.25rem;
    }
    .a11y-option {
      --option-padding: 0.875rem;
    }
    .a11y-option__head {
      gap: 0.5rem;
    }
    .a11y-option__icon {
      width: 2.25rem;
      height: 2.25rem;
    }
    .a11y-option__title {
      font-size: 1rem;
    }
  }
  .a11y-option__text {
    font-size: 0.9375rem;
  }
  .a11y-option:hover {
    background-color: var(--color-panel);
  }
  /* On: the whole box turns teal, with a thicker border so colour is not the only cue. */
  .a11y-option:has(input:checked) {
    padding: calc(var(--option-padding) - 1.5px);
    border-width: 3px;
    background-color: var(--color-highlight);
  }
  .a11y-option:has(input:checked) .a11y-option__icon {
    background-color: var(--color-background);
  }
  .a11y-option:has(input:focus-visible) {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }
  .a11y-option input:focus-visible {
    outline: none;
  }
  .a11y-panel__note {
    margin-top: 1rem;
    font-size: 0.9375rem;
  }
  .a11y-panel__done {
    width: 100%;
    margin-top: 1.5rem;
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const STORAGE_KEY = 'roam:a11y';
    const root = document.documentElement;
    // The panel can be opened from the header button and from the phone menu.
    const triggers = [...document.querySelectorAll('[data-a11y-open]')];
    const panel = document.querySelector('[data-a11y-panel]');
    if (triggers.length === 0 || !panel || typeof panel.showModal !== 'function') return;

    const canSpeak = 'speechSynthesis' in window;
    let prefs = {};
    try {
      prefs = JSON.parse(localStorage.getItem(STORAGE_KEY)) || {};
    } catch {}

    function apply() {
      root.classList.toggle('a11y-dyslexia', Boolean(prefs.dyslexia));
      root.classList.toggle('a11y-listen', Boolean(prefs.listen) && canSpeak);
      if (!prefs.listen && canSpeak) window.speechSynthesis.cancel();
    }

    const toggles = [...panel.querySelectorAll('[data-a11y-toggle]')];
    toggles.forEach((input) => {
      const name = input.dataset.a11yToggle;
      input.checked = Boolean(prefs[name]);
      input.addEventListener('change', () => {
        prefs[name] = input.checked;
        toggles.forEach((other) => {
          if (other.dataset.a11yToggle === name) other.checked = input.checked;
        });
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(prefs));
        } catch {
          // Storage can be blocked. The mode still applies to this page.
        }
        apply();
      });
    });

    if (!canSpeak) {
      toggles.forEach((input) => {
        if (input.dataset.a11yToggle !== 'listen') return;
        input.checked = false;
        input.disabled = true;
      });
      panel.querySelector('[data-a11y-no-speech]').hidden = false;
    }

    triggers.forEach((trigger) => {
      trigger.hidden = false;
      trigger.addEventListener('click', () => panel.showModal());
    });
    panel.querySelectorAll('[data-a11y-close]').forEach((button) => {
      button.addEventListener('click', () => panel.close());
    });
    // A click on the dimmed area outside the panel closes it. Escape does too, natively.
    panel.addEventListener('click', (event) => {
      if (event.target === panel) panel.close();
    });

    apply();

    // --- Point and listen: read whatever text the pointer rests on or the keyboard focuses ---

    if (!canSpeak) return;

    const synth = window.speechSynthesis;
    const READABLE =
      'h1, h2, h3, h4, h5, h6, p, li, a, button, label, legend, summary, dt, dd, th, td, figcaption, img[alt], input, select, textarea';
    let hoverTimer;
    let current = null;

    function readableFrom(node) {
      if (!(node instanceof Element)) return null;
      // The product page's Listen button manages its own speech.
      if (node.closest('[aria-hidden="true"], [data-listen]')) return null;
      return node.closest(READABLE);
    }

    function textOf(node) {
      if (node.matches('img')) return node.alt;
      if (node.matches('input, select, textarea')) {
        const label = node.labels && node.labels[0];
        return label ? label.innerText : node.getAttribute('aria-label') || '';
      }
      return node.getAttribute('aria-label') || node.innerText;
    }

    function hush() {
      if (current) current.classList.remove('is-being-read');
      current = null;
    }

    function speak(node) {
      if (!node || node === current || !root.classList.contains('a11y-listen')) return;
      const text = (textOf(node) || '').replace(/\s+/g, ' ').trim();
      if (!text) return;

      // Let other speech on the page (the Listen button) reset itself first.
      document.dispatchEvent(new Event('roam:speech-cancel'));
      synth.cancel();
      hush();
      current = node;
      node.classList.add('is-being-read');

      const utterance = new SpeechSynthesisUtterance(text.slice(0, 600));
      utterance.lang = root.lang || 'en';
      utterance.onend = utterance.onerror = () => {
        if (current === node) hush();
      };
      synth.speak(utterance);
    }

    // A short pause before speaking, so sweeping the pointer across the page stays quiet.
    document.addEventListener('mouseover', (event) => {
      clearTimeout(hoverTimer);
      // Some areas opt out of pointer reading, like the scrolling words.
      if (event.target instanceof Element && event.target.closest('[data-no-hover-read]')) return;
      const node = readableFrom(event.target);
      if (node) hoverTimer = setTimeout(() => speak(node), 250);
    });
    document.addEventListener('mouseout', (event) => {
      if (current && !current.contains(event.relatedTarget)) clearTimeout(hoverTimer);
    });
    document.addEventListener('focusin', (event) => speak(readableFrom(event.target)));

    // Escape always stops the voice.
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      synth.cancel();
      hush();
    });
    window.addEventListener('pagehide', () => synth.cancel());
  })();
{% endjavascript %}
