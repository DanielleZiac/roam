[
  {
    "name": "theme_info",
    "theme_name": "Roam",
    "theme_version": "0.1.0",
    "theme_author": "Roam",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "space_grotesk_n7",
        "label": "Headings"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "inter_n4",
        "label": "Body text"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "80rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "100rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "80rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "paragraph",
        "content": "The default Roam palette passes WCAG AA contrast. If you change a colour, re-check text contrast."
      },
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "Page background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#101418",
        "label": "Text"
      },
      {
        "type": "color",
        "id": "dark_color",
        "default": "#101418",
        "label": "Dark areas (footer, buttons)"
      },
      {
        "type": "color",
        "id": "highlight_color",
        "default": "#19D3C5",
        "label": "Highlight (bright teal)",
        "info": "Only used behind dark text. It is too pale to read as text on white."
      },
      {
        "type": "color",
        "id": "panel_color",
        "default": "#DCD6F7",
        "label": "Panels (soft lilac)"
      },
      {
        "type": "color",
        "id": "action_color",
        "default": "#4B2BE0",
        "label": "Accent (violet)",
        "info": "Links and hover states. Readable as text on white and on panels."
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 12
      }
    ]
  },
  {
    "name": "Store contact details",
    "settings": [
      {
        "type": "paragraph",
        "content": "Shown in the footer and on the Contact page. The defaults are placeholders: replace them with real details before launch."
      },
      {
        "type": "text",
        "id": "contact_email",
        "label": "Email",
        "default": "roamph@gmail.com"
      },
      {
        "type": "text",
        "id": "contact_chat",
        "label": "Text or chat number",
        "default": "+63 917 555 0142"
      },
      {
        "type": "text",
        "id": "contact_chat_apps",
        "label": "Chat apps",
        "default": "SMS, Viber and WhatsApp"
      },
      {
        "type": "text",
        "id": "contact_phone",
        "label": "Phone",
        "default": "(02) 8555 0142"
      },
      {
        "type": "textarea",
        "id": "contact_address",
        "label": "Address",
        "default": "Roam Showroom\nUnit 5, 128 Kalayaan Avenue\nDiliman, Quezon City 1101"
      },
      {
        "type": "text",
        "id": "contact_hours",
        "label": "Opening hours",
        "default": "Mon - Sat (9AM - 6PM)"
      },
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram link",
        "default": "https://example.com/instagram"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook link",
        "default": "https://example.com/facebook"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok link",
        "default": "https://example.com/tiktok"
      }
    ]
  }
]
